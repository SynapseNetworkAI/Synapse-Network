# Lark Alert Relay runtime configuration.
#
# This file is only an example. Real values must come from the deployment
# secret store, Kubernetes Secret, or another private runtime secret source.
# Never commit real Lark webhook URLs, signing keywords/secrets, tokens, or
# screenshots that expose those values.
#
# Lark group robot setup reminder:
# 1. Create a Lark group robot in the target group.
# 2. Copy its webhook URL into the matching LARK_WEBHOOK_* variable.
# 3. If the robot enables signature/keyword security, put the signing secret
#    into the matching LARK_SECRET_* variable.
# 4. If the robot uses only keyword verification, add the required keyword to
#    the card title or summary in Relay behavior; do not put a keyword into
#    LARK_SECRET_* unless Lark explicitly calls it a signing secret.
# 5. Before running npm run e2e:lark-alerts, confirm all three groups allow
#    receiving [LARK_E2E_TEST][NO_ACTION_REQUIRED] real webhook probes.

# Port used by scripts/ops/lark_alert_relay.mjs.
LARK_ALERT_RELAY_PORT=8787

# Bind address for the Relay process. Use 0.0.0.0 inside containers.
LARK_ALERT_RELAY_HOST=0.0.0.0

# Number of retry attempts when Lark webhook delivery fails.
LARK_ALERT_RELAY_MAX_RETRIES=2

# Synapse-P0-资金战情室.
# Receives only P0 production asset/security incidents.
# Example incidents: ledger/vault delta, negative balance attempt, withdrawal
# ticket replay/tamper, unexpected signer/owner change.
LARK_WEBHOOK_P0_WAR_ROOM=

# Lark signing secret for the P0 war room robot, if signature verification is
# enabled. Leave empty only when the robot does not require a signature.
LARK_SECRET_P0_WAR_ROOM=

# Synapse-Prod-告警大厅.
# Receives production P1/P2 operational alerts.
# Example incidents: gateway 5xx, provider outage, approval failure, deposit
# confirm lag, ClickHouse/Kafka lag, runner stale.
LARK_WEBHOOK_PROD_ALERTS=

# Lark signing secret for the production alerts robot, if enabled.
LARK_SECRET_PROD_ALERTS=

# Synapse-Staging-Drill-演练.
# Receives staging and drill-only alerts. This group must never page production
# on-call and must not share a webhook with production groups.
LARK_WEBHOOK_STAGING_DRILL=

# Lark signing secret for the staging drill robot, if enabled.
LARK_SECRET_STAGING_DRILL=
