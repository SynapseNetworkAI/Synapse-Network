project_id = "replace-with-your-gcp-project-id"
region     = "us-central1"

# Must be globally unique.
backup_bucket_name = "replace-with-unique-synapse-staging-backups-bucket"

artifact_registry_repository = "synapse-staging"
# Set to true only when testing cleanup candidates. Normal staging should keep
# this false so old untagged/staging images are actually removed.
artifact_registry_cleanup_policy_dry_run = false
artifact_registry_keep_recent_count      = 3

# Low-cost staging starts here. Upgrade to db-g1-small when E2E/load evidence
# shows connection, CPU, or latency pressure.
cloud_sql_tier                           = "db-f1-micro"
cloud_sql_edition                        = "ENTERPRISE"
cloud_sql_availability_type              = "ZONAL"
cloud_sql_activation_policy              = "NEVER"
cloud_sql_disk_type                      = "PD_SSD"
cloud_sql_disk_size_gb                   = 20
cloud_sql_disk_autoresize                = true
cloud_sql_deletion_protection            = false
cloud_sql_backup_start_time              = "19:00" # UTC; 03:00 Asia/Kuala_Lumpur
cloud_sql_transaction_log_retention_days = 1
cloud_sql_retained_backups               = 3

# Staging private Cloud SQL path. Direct VPC egress has no fixed connector VM
# cost and lets Cloud SQL release the public IPv4 reservation.
vpc_network_name                    = "synapse-staging-vpc"
vpc_subnet_name                     = "synapse-staging-subnet"
vpc_subnet_cidr                     = "10.40.0.0/24"
private_service_range_name          = "synapse-staging-sql-private-range"
private_service_range_prefix_length = 16

# Cost controls: staging scheduled workers default to lower frequency than prod.
deposit_indexer_schedule                   = "*/30 * * * *"
consumer_withdraw_chain_recovery_schedule  = "*/30 * * * *"
withdrawal_expiry_sweeper_schedule         = "*/30 * * * *"
notification_outbox_drain_schedule         = "*/30 * * * *"

# Optional: set container image URLs once Artifact Registry images exist.
# These are Docker/OCI images for Cloud Run, not website pictures.
# If left empty, Terraform provisions the substrate only and first deploy can use
# gcloud run deploy.
# Example:
# gateway_image = "us-central1-docker.pkg.dev/<project>/synapse-staging/gateway:<tag>"
gateway_image       = ""
gateway_admin_image = ""
user_front_image    = ""
admin_front_image   = ""
docs_front_image    = ""
provider_image      = ""

common_runtime_env = {
  ANALYTICS_KAFKA_BOOTSTRAP_SERVERS = ""
  CORS_ALLOW_ORIGINS                = "https://staging.synapse-network.ai"
  REDIS_URL                         = ""
  ROUTER_ADDRESS                    = "0x0bA1dcE1Cc8d877052ab1C3CE2362830459D8FF4"
  USDC_TOKEN_ADDRESS                = "0xfad31daE42B0046aFA106BCf56ED0dDaCA4463B9"
}

frontend_runtime_env = {
  NEXT_PUBLIC_GATEWAY_BASE_URL    = "https://api-staging.synapse-network.ai"
  NEXT_PUBLIC_ADMIN_API_BASE_URL  = "https://admin-api-staging.synapse-network.ai"
  NEXT_PUBLIC_DOCS_BASE_URL       = "https://docs-staging.synapse-network.ai"
  NEXT_PUBLIC_TX_EXPLORER_BASE_URL = "https://sepolia.arbiscan.io"
  NEXT_PUBLIC_CONSOLE_BASE_URL    = "https://staging.synapse-network.ai/dashboard/overview"
  ADMIN_API_PROXY_TARGET          = "https://admin-api-staging.synapse-network.ai"
  NEXT_PUBLIC_APP_ENV             = "staging"
}

labels = {
  owner = "synapse"
}
