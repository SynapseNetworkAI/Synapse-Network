# Copy to infra/docker/staging/.env before running the staging stack.
# Replace every placeholder with a real secret or staging endpoint.

# PostgreSQL bootstrap credentials
POSTGRES_USER=synapse
POSTGRES_PASSWORD=replace-with-strong-postgres-superuser-password
POSTGRES_DB=synapse_gateway

# Gateway database accounts
SYNAPSE_GATEWAY_DB=synapse_gateway
SYNAPSE_GATEWAY_APP_USER=synapse_gateway_app
SYNAPSE_GATEWAY_APP_PASSWORD=replace-with-staging-gateway-app-password
SYNAPSE_GATEWAY_READONLY_USER=synapse_gateway_ro
SYNAPSE_GATEWAY_READONLY_PASSWORD=replace-with-staging-gateway-ro-password
SYNAPSE_GATEWAY_MIGRATOR_USER=synapse_gateway_migrator
SYNAPSE_GATEWAY_MIGRATOR_PASSWORD=replace-with-staging-gateway-migrator-password

# Admin control-plane database accounts
SYNAPSE_ADMIN_DB=synapse_gateway_admin
SYNAPSE_ADMIN_APP_USER=synapse_admin_app
SYNAPSE_ADMIN_APP_PASSWORD=replace-with-staging-admin-app-password
SYNAPSE_ADMIN_READONLY_USER=synapse_admin_ro
SYNAPSE_ADMIN_READONLY_PASSWORD=replace-with-staging-admin-ro-password
SYNAPSE_ADMIN_MIGRATOR_USER=synapse_admin_migrator
SYNAPSE_ADMIN_MIGRATOR_PASSWORD=replace-with-staging-admin-migrator-password

# Analytics pipeline + cache
REDIS_PASSWORD=replace-with-staging-redis-password
CLICKHOUSE_DB=synapse_analytics
CLICKHOUSE_USER=synapse_analytics_app
CLICKHOUSE_PASSWORD=replace-with-staging-clickhouse-password

# Kafka (KRaft) metadata
KAFKA_CLUSTER_ID=replace-with-base64-cluster-id
KAFKA_ADVERTISED_ENDPOINT=PLAINTEXT://gateway-kafka:9092
