# Keep Cloud Build source uploads small and deterministic.
#
# This file is intentionally separate from .gitignore because Cloud Build sends
# a source archive to Google before building images. Large local dependencies
# and evidence outputs should never be uploaded.

.git/
.DS_Store

# Local dependencies and virtualenvs
node_modules/
**/node_modules/
.venv/
**/.venv/
venv/

# Build/test outputs
.next/
**/.next/
dist/
**/dist/
coverage/
coverage.json
coverage.xml
.coverage
.coverage.*
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
**/__pycache__/
*.pyc

# Contract/generated artifacts
artifacts/
cache/
typechain/
typechain-types/

# Runtime/generated evidence and local scratch data
output/
logs/
*.log
tmp/
docs/evidence/alerts/lark/*-lark-e2e/

# Local secrets and Terraform local inputs
.env
*.tfvars
*.tfvars.json
!*.tfvars.example
services/*/.env.local
services/*/.env.staging
services/*/.env.prod

# Local browser automation state
.agent-browser/

# Local scratch image exports
logo.png
