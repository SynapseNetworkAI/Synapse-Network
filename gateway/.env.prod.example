# Production profile (PostgreSQL storage)
ENVIRONMENT=prod

# Chain RPC for production/testnet environment
RPC_URL=https://your-rpc-provider.example

# Production storage backend
STORAGE_BACKEND=postgres
POSTGRES_DSN=postgresql://synapse_gateway_app:change_me@postgres:5432/synapse_gateway
POSTGRES_AUTO_INIT=0

# Runtime artifact root
RUNTIME_STORAGE_DIR=./runtime_storage

# API bind (container/internal network)
SELLER_API_HOST=0.0.0.0
SELLER_API_PORT=8000

# Security (MUST replace)
JWT_SECRET=replace-with-production-secret-32-bytes-min
AUTH_SECRET=replace-with-production-secret-32-bytes-min

# Optional redis
REDIS_URL=
