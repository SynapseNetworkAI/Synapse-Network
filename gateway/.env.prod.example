# ==================================================
# Synapse Gateway 生产环境示例
# 用途：复制为 .env.prod 后替换所有占位值。
# ==================================================

# --------------------------------------------------
# 必须自己配置，不能直接拿示例上线
# --------------------------------------------------

# 运行环境标识，生产固定为 prod。
ENVIRONMENT=prod

# 生产链 RPC。
# 必须自己配置：是。
RPC_URL=https://your-rpc-provider.example

# 生产 SynapseCore / vault / router 合约地址。
# 必须自己配置：是。
ROUTER_ADDRESS=0xYourProductionSynapseCoreAddress

# 生产 USDC 合约地址。
# 必须自己配置：是。
USDC_TOKEN_ADDRESS=0xYourProductionUsdcAddress

# 存储后端，当前只支持 postgres。
STORAGE_BACKEND=postgres

# 生产 PostgreSQL 连接串。
# 必须自己配置：是。
POSTGRES_DSN=postgresql://synapse_gateway_app:change_me@postgres:5432/synapse_gateway

# 生产建议迁移完成后设为 0，避免应用启动时隐式建表。
POSTGRES_AUTO_INIT=0

# provider_fastapi 兼容入口监听地址。
# 可留默认：是。
PROVIDER_API_HOST=0.0.0.0

# provider_fastapi 兼容入口监听端口。
# 可留默认：是。
PROVIDER_API_PORT=8000

# JWT 鉴权密钥。
# 必须自己配置：是。
JWT_SECRET=replace-with-production-secret-32-bytes-min

# Challenge / auth 密钥；建议和 JWT_SECRET 分开配置。
# 必须自己配置：建议是。
AUTH_SECRET=replace-with-production-secret-32-bytes-min

# --------------------------------------------------
# 可按需显式覆盖，留空时走默认值
# --------------------------------------------------

# Redis 连接；不需要分布式限流可不填。
REDIS_URL=

# 平台手续费比例；默认 0.10。
# PLATFORM_FEE_RATE=0.10

# 路由税；默认 0.0001 USDC。
# GATEWAY_ROUTING_TAX=0.0001

# 平台费率管理钱包白名单。
# PLATFORM_FEE_ADMIN_WALLETS=0xYourAdminWallet
