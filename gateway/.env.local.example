# ==================================================
# Synapse Gateway 本地环境示例
# 用途：复制为 .env.local 后按注释逐项替换。
# ==================================================

# --------------------------------------------------
# 必须自己配置 / 至少必须核对的项
# --------------------------------------------------

# 运行环境标识，本地固定为 local。
ENVIRONMENT=local

# 本地区块链 RPC。
# 必须自己配置：是。
RPC_URL=http://127.0.0.1:8545

# 本地 SynapseCore / vault / router 合约地址。
# 必须自己配置：建议是；如果 frontend contract-config.json 正确，也可省略。
ROUTER_ADDRESS=0xYourLocalSynapseCoreAddress

# 本地 USDC 合约地址。
# 必须自己配置：建议是；如果 frontend contract-config.json 正确，也可省略。
USDC_TOKEN_ADDRESS=0xYourLocalUsdcAddress

# 存储后端。当前只支持 postgres。
STORAGE_BACKEND=postgres

# 本地 PostgreSQL 连接串。
# 必须自己配置：是。
POSTGRES_DSN=postgresql://synapse_gateway_app:12345678@127.0.0.1:5432/synapse_gateway

# 是否启动时自动建表。本地首次启动可设为 1；如果库已建好，可改成 0。
# 可留默认：是。
POSTGRES_AUTO_INIT=0

# seller_fastapi 兼容入口监听地址。
# 可留默认：是。
SELLER_API_HOST=127.0.0.1

# seller_fastapi 兼容入口监听端口。
# 可留默认：是。
SELLER_API_PORT=8000

# JWT 鉴权密钥。
# 必须自己配置：是。
JWT_SECRET=replace-this-with-a-32-byte-minimum-jwt-secret

# Challenge / auth 密钥；不写会回退到 JWT_SECRET，但建议显式写上。
# 必须自己配置：建议是。
AUTH_SECRET=replace-this-with-a-32-byte-minimum-jwt-secret

# --------------------------------------------------
# 可按需显式覆盖，留空时走默认值
# --------------------------------------------------

# 平台手续费比例；默认 0.10。
# PLATFORM_FEE_RATE=0.10

# 路由税；默认 0.0001 USDC。
# GATEWAY_ROUTING_TAX=0.0001

# Redis 连接串；单机调试可不填。
# REDIS_URL=redis://localhost:6379/0

# 充值确认数；默认 1。
# V2_DEPOSIT_CONFIRMATIONS=1

# 对账告警阈值；默认 1.0 USDC。
# V2_RECONCILIATION_ALERT_DELTA_USDC=1.0
