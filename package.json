{
  "name": "synapse-contract-toolchain",
  "private": true,
  "version": "0.1.0",
  "description": "Local Hardhat toolchain for Synapse contract deployment and test scripts",
  "scripts": {
    "ci:admin-front": "bash scripts/ci/admin_front_checks.sh",
    "ci:admin-gateway": "bash scripts/ci/admin_gateway_checks.sh",
    "ci:contracts": "bash scripts/ci/contracts_checks.sh",
    "ci:docs": "bash scripts/ci/docs_checks.sh",
    "ci:docs-pages": "cd services/user-front && yarn test:docs-pages",
    "ci:frontend": "bash scripts/ci/frontend_checks.sh",
    "ci:gateway": "bash scripts/ci/gateway_checks.sh",
    "ci:gateway-stress-review": "bash scripts/ci/gateway_stress_review_checks.sh",
    "ci:performance-reliability": "bash scripts/ci/performance_reliability_checks.sh",
    "ci:pr": "bash scripts/ci/pr_checks.sh",
    "ci:provider-service": "bash scripts/ci/provider_service_checks.sh",
    "ci:user-front-pages": "cd services/user-front && yarn test:user-front-pages",
    "ci:release-go-no-go": "bash scripts/ci/release_go_no_go_checks.sh",
    "ci:sdk-python": "bash scripts/ci/sdk_python_checks.sh",
    "perf:local-reliability-suite": "bash scripts/perf/local_reliability_suite.sh",
    "perf:staging-load-suite": "bash scripts/perf/staging_load_suite.sh",
    "perf:gateway-load": "bash scripts/perf/gateway_load.sh",
    "perf:local-smoke": "bash scripts/perf/local_smoke.sh",
    "perf:finance-load": "bash scripts/perf/finance_load.sh",
    "perf:provider-health-load": "bash scripts/perf/provider_health_load.sh",
    "perf:admin-load": "bash scripts/perf/admin_load.sh",
    "perf:money-concurrency": "bash scripts/perf/money_concurrency.sh",
    "chaos:staging-suite": "bash scripts/chaos/staging_chaos_suite.sh",
    "chaos:provider-outage": "bash scripts/chaos/provider_outage.sh",
    "chaos:gateway-restart": "bash scripts/chaos/gateway_restart.sh",
    "chaos:gateway-admin-restart": "bash scripts/chaos/gateway_admin_restart.sh",
    "chaos:analytics-outage": "bash scripts/chaos/analytics_outage.sh",
    "chaos:rpc-outage": "bash scripts/chaos/rpc_outage.sh",
    "chaos:postgres-failover": "bash scripts/chaos/postgres_failover.sh",
    "chaos:redis-unavailable": "bash scripts/chaos/redis_unavailable.sh",
    "drill:staging-recovery-suite": "bash scripts/drills/staging_recovery_suite.sh",
    "drill:application-rollback": "bash scripts/drills/application_rollback.sh",
    "drill:config-rollback": "bash scripts/drills/config_rollback.sh",
    "drill:signer-rollback": "bash scripts/drills/signer_rollback.sh",
    "e2e:user-front-fullchain:seed": "node scripts/e2e/user_front_fullchain_seed.mjs",
    "e2e:user-front-fullchain:verify": "USER_FRONT_VERIFY_MODE=fullchain USER_FRONT_VERIFY_REAL_BACKEND=1 USER_FRONT_FULLCHAIN_FIXTURE=tmp/user-front-fullchain/fixture.json node scripts/ui/verify_user_front_pages.mjs",
    "e2e:user-front-fullchain": "npm run e2e:user-front-fullchain:seed && npm run e2e:user-front-fullchain:verify",
    "e2e:admin-front:seed": "node scripts/e2e/admin_front_seed.mjs",
    "e2e:admin-front:dogfood": "node scripts/ui/dogfood_admin_front.mjs",
    "e2e:admin-front:reconcile": "node scripts/e2e/admin_front_reconcile.mjs",
    "e2e:admin-front": "npm run e2e:admin-front:seed && npm run e2e:admin-front:dogfood && npm run e2e:admin-front:reconcile",
    "e2e:admin-analytics-10k:fullchain": "node scripts/e2e/admin_analytics_10k_fullchain.mjs",
    "e2e:admin-analytics-10k:prepare": "node scripts/e2e/admin_analytics_10k_prepare_local.mjs",
    "e2e:admin-analytics-10k:reconcile": "node scripts/e2e/admin_analytics_10k_reconcile.mjs",
    "e2e:admin-analytics-10k:dogfood": "node scripts/ui/dogfood_admin_analytics_10k.mjs",
    "e2e:admin-analytics-10k": "npm run e2e:admin-analytics-10k:fullchain && npm run e2e:admin-analytics-10k:reconcile && npm run e2e:admin-analytics-10k:dogfood"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.2",
    "chai": "^4.5.0",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.0",
    "hardhat-gas-reporter": "^2.3.0",
    "playwright": "^1.59.1",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^6.0.2"
  }
}
