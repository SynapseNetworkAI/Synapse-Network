# Synapse-Network production operator config.
# Copy to env.prod for local deployment/operator use. Do not commit env.prod.
#
# Plain env only. Keep DB DSNs/passwords, JWT/AUTH secrets, SMTP app passwords,
# Lark secrets, API keys, admin/TOTP secrets, wallet/private keys, provider
# owner private keys, and KMS private material in Secret Manager.

SYNAPSE_ENV=prod
ENVIRONMENT=prod
NODE_ENV=production

PUBLIC_APP_BASE_URL=https://app.synapse-network.ai
PUBLIC_GATEWAY_BASE_URL=https://api.synapse-network.ai
PUBLIC_ADMIN_BASE_URL=https://admin.synapse-network.ai
PUBLIC_ADMIN_API_BASE_URL=https://admin-api.synapse-network.ai
PUBLIC_DOCS_BASE_URL=https://docs.synapse-network.ai
CORS_ALLOW_ORIGINS=https://app.synapse-network.ai,https://admin.synapse-network.ai,https://docs.synapse-network.ai

NEXT_PUBLIC_APP_ENV=prod
NEXT_PUBLIC_GATEWAY_BASE_URL=https://api.synapse-network.ai
NEXT_PUBLIC_ADMIN_API_BASE_URL=https://admin-api.synapse-network.ai
NEXT_PUBLIC_DOCS_BASE_URL=https://docs.synapse-network.ai
NEXT_PUBLIC_CONSOLE_BASE_URL=https://app.synapse-network.ai/dashboard/overview
NEXT_PUBLIC_TX_EXPLORER_BASE_URL=https://arbiscan.io
ADMIN_API_PROXY_TARGET=https://admin-api.synapse-network.ai

CHAIN_ID=42161
CHAIN_NAME=arbitrum-one
ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
USDC_TOKEN_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
WITHDRAW_SIGNER_MODE=gcp_kms
WITHDRAW_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
WITHDRAW_SIGNER_GCP_KMS_KEY_NAME=projects/<project>/locations/us-central1/keyRings/<ring>/cryptoKeys/<key>/cryptoKeyVersions/1
PLATFORM_FEE_ADMIN_WALLETS=0x0000000000000000000000000000000000000000
INDEXER_ADMIN_WALLETS=0x0000000000000000000000000000000000000000

STORAGE_BACKEND=postgres
POSTGRES_HOST=/cloudsql/<project>:us-central1:synapse-prod-postgres
POSTGRES_DB=synapse
POSTGRES_USER=synapse_gateway_app
POSTGRES_MIGRATOR_USER=synapse_gateway_migrator
POSTGRES_CONNECT_TIMEOUT_SEC=5
POSTGRES_POOL_MAX=5
POSTGRES_AUTO_INIT=0

V2_INDEXER_ENABLED=true
PROVIDER_WITHDRAW_EXPIRY_REAPER_ENABLED=true
CONSUMER_WITHDRAW_PROCESSOR_ENABLED=true
CONSUMER_WITHDRAW_CHAIN_RECOVERY_ENABLED=true
WITHDRAWAL_EXPIRY_SWEEPER_ENABLED=true
WITHDRAWAL_AUTO_SINGLE_LIMIT_USDC=1.000000
WITHDRAWAL_TIMEOUT_ALERT_AFTER_SEC=900

ANALYTICS_TRANSPORT=outbox
ANALYTICS_STRICT_KAFKA=false
ANALYTICS_KAFKA_BOOTSTRAP_SERVERS=
DOWNSTREAM_ADAPTIVE_REDIS_ENABLED=false
REDIS_URL=

EMAIL_OUTBOX_ENABLED=true
EMAIL_TRANSPORT=gmail_smtp
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
EMAIL_FROM=Synapse Network <alerts@synapse-network.ai>
EMAIL_REPLY_TO=support@synapse-network.ai

GATEWAY_PROVIDER_SIGNATURE_ENABLED=true
GATEWAY_PROVIDER_SIGNATURE_MAX_SKEW_S=300
NOTIFICATION_OUTBOX_TRIGGER_ENABLED=true
NOTIFICATION_OUTBOX_TRIGGER_URL=http://127.0.0.1:8000/internal/jobs/notification-outbox/trigger
NOTIFICATION_OUTBOX_TRIGGER_TIMEOUT_SEC=3
NOTIFICATION_OUTBOX_FALLBACK_ENABLED=true
TRANSACTION_LARK_ENABLED=false
IN_APP_NOTIFICATION_CLEANUP_ENABLED=false
STAGING_ALERT_DRILL_ENABLED=false

PROVIDER_ENV=prod
PROVIDER_RUNTIME_ROLE=runtime
PROVIDER_PUBLIC_BASE_URL=https://provider.synapse-network.ai
PROVIDER_GATEWAY_REGISTRATION_EXPECTED=true
PROVIDER_PUBLIC_DOCS_ENABLED=false
PROVIDER_STAGING_ENABLED_SERVICES_JSON=[]
PROVIDER_MAX_BODY_BYTES=131072
PROVIDER_MAX_RESPONSE_BYTES=1048576
PROVIDER_GLOBAL_QPS=20
PROVIDER_SERVICE_QPS_JSON={}
