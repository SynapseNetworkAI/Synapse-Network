# Production profile (PostgreSQL storage)
ENVIRONMENT=prod

# Chain RPC for production/testnet environment
RPC_URL=http://127.0.0.1:8545

# Production storage backend
STORAGE_BACKEND=postgres
# Password override supported: if set, it will override password segment in POSTGRES_DSN.
POSTGRES_PASSWORD=12345678
POSTGRES_DSN=postgresql://synapse:12345678@postgres:5432/synapse_gateway
POSTGRES_AUTO_INIT=1

# Runtime artifact root
RUNTIME_STORAGE_DIR=./runtime_storage

# API bind (container/internal network)
SELLER_API_HOST=0.0.0.0
SELLER_API_PORT=8000

# Security (MUST replace)
JWT_SECRET=PGZTIANEBQT20wG9oNZrLSwGKqKJy-3Z
AUTH_SECRET=pfazKmMdEZ8RCTB-8A_hH9AAknSXoP6y

# Optional redis
# Supports REDIS_URL with or without scheme, and optional REDIS_PASSWORD override.
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
