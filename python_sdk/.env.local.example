# Local development profile (JSON storage)
ENVIRONMENT=local

# Keep local wallet/indexer RPC
RPC_URL=http://127.0.0.1:8545

# Local storage backend
STORAGE_BACKEND=json
RUNTIME_STORAGE_DIR=./runtime_storage
DATA_DIR=./runtime_storage

# Keep postgres fields empty in local
POSTGRES_DSN=
POSTGRES_AUTO_INIT=1

# Local API bind
SELLER_API_HOST=127.0.0.1
SELLER_API_PORT=8000

# Security defaults for local testing only
JWT_SECRET=replace-this-with-a-32-byte-minimum-jwt-secret
AUTH_SECRET=replace-this-with-a-32-byte-minimum-jwt-secret
