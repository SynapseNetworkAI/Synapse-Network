# API Configurations for AI Agent Daemons
API_BASE_URL="http://127.0.0.1:8000/api/client"

# DeepSeek Configuration (Required for Real AI execution)
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
# For v1: https://api.deepseek.com
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Storage Strategy (DATA_URI, MINIO)
# Data URI is suitable for small text, MINIO is for S3 compatible local or cloud OSS
STORAGE_MODE="MINIO"

# MinIO/S3 Configuration (Required if STORAGE_MODE=MINIO)
MINIO_ENDPOINT="http://127.0.0.1:9000"
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="12345678"
MINIO_BUCKET_NAME="a2a-payloads"
