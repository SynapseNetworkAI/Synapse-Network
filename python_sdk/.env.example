# ==================================================
# Synapse Network Unified Configuration (.env)
# Source of truth: seller_api/src/core/config.py
# ==================================================

# Runtime mode flag used by gateway behavior switches.
ENVIRONMENT=development

# RPC endpoint used by chain readers/indexer.
RPC_URL=http://127.0.0.1:8545

# Router contract address (optional if frontend contract-config.json exists).
ROUTER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional private key for maintenance/legacy chain operations.
PRIVATE_KEY=

# Optional contract address used by compatibility paths.
CONTRACT_ADDRESS=

# --------------------------------------------------
# Indexer
# --------------------------------------------------

# Confirmations required before crediting deposits.
V2_DEPOSIT_CONFIRMATIONS=1

# Poll interval in seconds for the background indexer loop.
V2_INDEXER_POLL_INTERVAL_SEC=2

# Reserved block batch size for scaling upgrades.
V2_INDEXER_BLOCK_BATCH=100

# --------------------------------------------------
# Runtime storage
# --------------------------------------------------

# Root directory for runtime JSON artifacts.
RUNTIME_STORAGE_DIR=./runtime_storage

# JsonStorage data directory (defaults to RUNTIME_STORAGE_DIR when omitted).
DATA_DIR=./runtime_storage

# --------------------------------------------------
# Auth / security
# --------------------------------------------------

# JWT signing key for API auth.
JWT_SECRET=replace-this-with-a-32-byte-minimum-jwt-secret

# Optional auth-secret alias (defaults to JWT_SECRET if omitted).
AUTH_SECRET=replace-this-with-a-32-byte-minimum-jwt-secret

# Issued auth token TTL in seconds.
AUTH_TOKEN_TTL_SEC=86400

# Wallet challenge TTL in seconds.
AUTH_CHALLENGE_TTL_SEC=600

# Financial idempotency record ttl in seconds.
FINANCE_IDEMPOTENCY_TTL_SEC=86400

# Max retained idempotency rows after pruning.
FINANCE_IDEMPOTENCY_MAX_ROWS=10000

# Replay-protection window for duplicate tx/refund attempts in seconds.
FINANCE_REPLAY_WINDOW_SEC=900

# Owner write rate limit for finance mutation endpoints (per minute).
FINANCE_WRITE_RATE_LIMIT_PER_MIN=60

# Keep legacy auth behavior enabled (1=true, 0=false).
ALLOW_LEGACY_AUTH=1

# --------------------------------------------------
# Rate limit / credential policy
# --------------------------------------------------

# Default credential TTL in seconds.
AGENT_CREDENTIAL_DEFAULT_TTL_SEC=3600

# Maximum allowed credential TTL in seconds.
AGENT_CREDENTIAL_MAX_TTL_SEC=259200

# Default max calls for a new credential.
AGENT_CREDENTIAL_MAX_CALLS_DEFAULT=1000

# Owner control-plane rate limit per minute.
OWNER_RATE_LIMIT_PER_MIN=240

# Credential data-plane rate limit per minute.
AGENT_RATE_LIMIT_PER_MIN=600

# Service aggregate rate limit per minute.
SERVICE_RATE_LIMIT_PER_MIN=1200

# Shared rate-limit window in seconds.
RATE_LIMIT_WINDOW_SEC=60

# Require X-Credential for /generate endpoint (1=true, 0=false).
REQUIRE_AGENT_CREDENTIAL_FOR_GENERATE=0

# Optional Redis URL for distributed counters/rate limits.
REDIS_URL=

# --------------------------------------------------
# Legacy payment compatibility
# --------------------------------------------------

# Fallback seller wallet for compatibility paths.
SELLER_ADDRESS=0x0000000000000000000000000000000000000000

# Fallback expected price in wei.
EXPECTED_PRICE=1000000000000000000

# Confirmations required by legacy payment verification.
MIN_CONFIRMATIONS=1

# Max pending-payment wait time in seconds.
PAYMENT_TTL_SEC=600

# Optional comma-separated accepted token addresses.
ALLOWED_TOKEN_ADDRESSES=

# Optional service static-price map JSON (serviceId -> wei).
SERVICE_PRICES_JSON={}

# --------------------------------------------------
# API server bind
# --------------------------------------------------

# Main app bind host/port.
HOST=0.0.0.0
PORT=5000

# seller_fastapi.py launcher bind host/port.
SELLER_API_HOST=127.0.0.1
SELLER_API_PORT=8000

# --------------------------------------------------
# Optional explicit runtime JSON paths
# Leave empty to use defaults under runtime_storage.
# --------------------------------------------------

SERVICE_REGISTRY_PATH=
AGENT_REGISTRY_PATH=
AGENT_CREDENTIALS_PATH=
AUDIT_LOG_PATH=
BALANCE_LEDGER_PATH=
USAGE_LOG_PATH=
DEPOSIT_INTENTS_PATH=
DEPOSIT_EVENT_CURSOR_PATH=
DEPOSIT_EVENT_PROCESSED_PATH=
REFUND_INTENTS_PATH=
ROUTER_CONFIG_PATH=
WALLET_ROLES_PATH=
PROVIDER_SECRETS_PATH=

# --------------------------------------------------
# SDK/client side environment examples
# --------------------------------------------------

API_BASE_URL=http://127.0.0.1:8000/api/client
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
STORAGE_MODE=MINIO
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=12345678
MINIO_BUCKET_NAME=a2a-payloads
