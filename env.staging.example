# Synapse-Network staging operator config.
# Copy to env.staging for local deployment/operator use. Do not commit env.staging.
#
# This file is for plain runtime values only. Keep DB DSNs/passwords, JWT/AUTH
# secrets, SMTP app passwords, Lark secrets, API keys, admin/TOTP secrets,
# wallet/private keys, provider owner private keys, and KMS private material in
# Secret Manager.

SYNAPSE_ENV=staging
ENVIRONMENT=staging
NODE_ENV=production

PUBLIC_APP_BASE_URL=https://staging.synapse-network.ai
PUBLIC_GATEWAY_BASE_URL=https://api-staging.synapse-network.ai
PUBLIC_ADMIN_BASE_URL=https://admin-staging.synapse-network.ai
PUBLIC_ADMIN_API_BASE_URL=https://admin-api-staging.synapse-network.ai
PUBLIC_DOCS_BASE_URL=https://docs-staging.synapse-network.ai
CORS_ALLOW_ORIGINS=https://staging.synapse-network.ai

NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_GATEWAY_BASE_URL=https://api-staging.synapse-network.ai
NEXT_PUBLIC_ADMIN_API_BASE_URL=https://admin-api-staging.synapse-network.ai
NEXT_PUBLIC_DOCS_BASE_URL=https://docs-staging.synapse-network.ai
NEXT_PUBLIC_CONSOLE_BASE_URL=https://staging.synapse-network.ai/dashboard/overview
NEXT_PUBLIC_TX_EXPLORER_BASE_URL=https://sepolia.arbiscan.io
ADMIN_API_PROXY_TARGET=https://admin-api-staging.synapse-network.ai

CHAIN_ID=421614
CHAIN_NAME=arbitrum-sepolia
ROUTER_ADDRESS=0x0bA1dcE1Cc8d877052ab1C3CE2362830459D8FF4
USDC_TOKEN_ADDRESS=0xfad31daE42B0046aFA106BCf56ED0dDaCA4463B9
WITHDRAW_SIGNER_MODE=gcp_kms
WITHDRAW_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
WITHDRAW_SIGNER_GCP_KMS_KEY_NAME=projects/<project>/locations/us-central1/keyRings/<ring>/cryptoKeys/<key>/cryptoKeyVersions/1
PLATFORM_FEE_ADMIN_WALLETS=0x0000000000000000000000000000000000000000
INDEXER_ADMIN_WALLETS=0x0000000000000000000000000000000000000000

STORAGE_BACKEND=postgres
POSTGRES_HOST=/cloudsql/<project>:us-central1:synapse-staging-postgres
POSTGRES_DB=synapse
POSTGRES_USER=synapse_gateway_app
POSTGRES_MIGRATOR_USER=synapse_gateway_migrator
POSTGRES_CONNECT_TIMEOUT_SEC=5
POSTGRES_POOL_MAX=5
POSTGRES_AUTO_INIT=0

V2_INDEXER_ENABLED=false
PROVIDER_WITHDRAW_EXPIRY_REAPER_ENABLED=false
CONSUMER_WITHDRAW_PROCESSOR_ENABLED=false
CONSUMER_WITHDRAW_CHAIN_RECOVERY_ENABLED=false
WITHDRAWAL_EXPIRY_SWEEPER_ENABLED=false
WITHDRAWAL_AUTO_SINGLE_LIMIT_USDC=1.000000
WITHDRAWAL_TIMEOUT_ALERT_AFTER_SEC=900

ANALYTICS_TRANSPORT=outbox
ANALYTICS_STRICT_KAFKA=false
ANALYTICS_KAFKA_BOOTSTRAP_SERVERS=
DOWNSTREAM_ADAPTIVE_REDIS_ENABLED=false
REDIS_URL=

EMAIL_OUTBOX_ENABLED=true
EMAIL_TRANSPORT=gmail_smtp
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
EMAIL_FROM=Synapse Network Staging <staging-alerts@synapse-network.ai>
EMAIL_REPLY_TO=support@synapse-network.ai

GATEWAY_PROVIDER_SIGNATURE_ENABLED=true
GATEWAY_PROVIDER_SIGNATURE_MAX_SKEW_S=300
NOTIFICATION_OUTBOX_TRIGGER_ENABLED=true
NOTIFICATION_OUTBOX_TRIGGER_URL=http://127.0.0.1:8000/internal/jobs/notification-outbox/trigger
NOTIFICATION_OUTBOX_TRIGGER_TIMEOUT_SEC=3
NOTIFICATION_OUTBOX_FALLBACK_ENABLED=true
TRANSACTION_LARK_ENABLED=true
IN_APP_NOTIFICATION_CLEANUP_ENABLED=false
STAGING_ALERT_DRILL_ENABLED=true

PROVIDER_ENV=staging
PROVIDER_RUNTIME_ROLE=runtime
PROVIDER_PUBLIC_BASE_URL=https://provider-staging.synapse-network.ai
PROVIDER_GATEWAY_REGISTRATION_EXPECTED=true
PROVIDER_PUBLIC_DOCS_ENABLED=false
PROVIDER_STAGING_ENABLED_SERVICES_JSON=["web3-sentiment-index","protocol-fundamental-brief","oss-security-healthcheck","deepseek-chat"]
PROVIDER_MAX_BODY_BYTES=131072
PROVIDER_MAX_RESPONSE_BYTES=1048576
PROVIDER_GLOBAL_QPS=5
PROVIDER_SERVICE_QPS_JSON={"web3-sentiment-index":2,"protocol-fundamental-brief":1,"oss-security-healthcheck":1,"deepseek-chat":1}
