# ============================================================
# Synapse gateway-admin 本地开发环境配置
# 文件用途：本机开发 / 联调 / 单机运维验证
# 启动方式：默认被 scripts/ops/start-local.sh 自动加载
# 注意：该文件只适合 local，不适合直接用于生产
# ============================================================

# 运行环境名称。
# 作用：控制配置分支与 development 下的额外 CORS 放宽逻辑。
environment=development

# 服务监听地址。
# 作用：决定 uvicorn 绑定在哪个网卡；本地联调用 0.0.0.0 即可。
ADMIN_GATEWAY_HOST=0.0.0.0

# 服务监听端口。
# 作用：gateway-admin 对外暴露的 HTTP 端口。
ADMIN_GATEWAY_PORT=8300

# 是否开启调试模式。
# 作用：本地开发可保留 true，方便排错；生产必须关闭。
ADMIN_GATEWAY_DEBUG=true

# 允许跨域访问的前端来源，多个值用英文逗号分隔。
# 作用：控制管理后台前端、本地调试页是否能访问本服务。
ADMIN_GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000

# 管理员令牌前缀。
# 作用：区分 admin token 与其他系统 token，便于审计和前缀校验。
ADMIN_GATEWAY_TOKEN_PREFIX=adm_demo_

# gateway-admin 自身控制面数据库 DSN。
# 作用：存储后台用户、菜单配置、审批流、执行任务、管理员审计等数据。
ADMIN_DATABASE_DSN=postgresql://synapse_admin_app:12345678@localhost:5432/synapse_gateway_admin

# gateway-admin migration 数据库 DSN。
# 作用：手工执行 scripts/apply_migrations.py 时使用；本地使用 docker-compose 初始化的 postgres 超级用户，避免旧 volume 缺表时因为 app 账号没有 CREATE 权限而补 migration 失败。
ADMIN_DATABASE_MIGRATION_DSN=postgresql://synapse:12345678@localhost:5432/synapse_gateway_admin

# gateway 主库只读连接 DSN。
# 作用：读取 gateway 侧 projection / dashboard 数据，禁止写 gateway 真相表。
GATEWAY_READONLY_DSN=postgresql://synapse_gateway_ro:12345678@localhost:5432/synapse_gateway

# gateway 内部管理接口基础地址。
# 作用：execution worker 或后台受控操作回调 gateway 内部管理端点。
GATEWAY_INTERNAL_BASE_URL=http://localhost:8000

# gateway 内部管理钱包地址。
# 作用：生成内部管理员 JWT 时作为管理员身份主体，驱动受控内部操作。
GATEWAY_INTERNAL_ADMIN_WALLET=0xYourGatewayAdminWallet

# gateway 内部管理 JWT 密钥。
# 作用：签发 gateway-admin -> gateway 的内部管理 JWT；本地可测试值，生产必须替换为高强度密钥。
GATEWAY_INTERNAL_JWT_SECRET=replace-this-with-a-32-byte-minimum-jwt-secret

# 调用 gateway 内部接口的超时时间，单位秒。
# 作用：限制 execution worker 或后台命令等待 gateway 返回的最长时间，避免后台线程卡死。
GATEWAY_INTERNAL_TIMEOUT_SEC=10

# 是否开启 execution worker。
# 作用：本地联调时通常开启，使待执行 job 自动被扫描并推进。
EXECUTION_WORKER_ENABLED=true

# execution worker 轮询间隔，单位秒。
# 作用：控制后台扫描待执行任务的频率；值越小响应越快，但轮询压力越高。
EXECUTION_WORKER_POLL_INTERVAL_SEC=5

# execution worker 单次批处理数量。
# 作用：控制每轮最多拉取多少个待执行 job，避免单次批量过大拖慢后台。
EXECUTION_WORKER_BATCH_SIZE=10

# 是否启用内存存储模式。
# 作用：仅用于无数据库的临时演示 / 极简调试；正常 local 联调与所有生产环境都应为 false。
ADMIN_GATEWAY_USE_INMEMORY_STORE=false
