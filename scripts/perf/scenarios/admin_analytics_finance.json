{
  "name": "admin-analytics-finance",
  "baseUrlEnv": "SYNAPSE_ADMIN_GATEWAY_BASE_URL",
  "headers": {
    "Cookie": "${SYNAPSE_ADMIN_COOKIE_HEADER}",
    "X-CSRF-Token": "${SYNAPSE_ADMIN_CSRF_TOKEN}"
  },
  "requests": [
    {
      "name": "analytics-overview",
      "method": "GET",
      "path": "/api/admin/v1/dashboard/analytics/overview?window=7d",
      "expectedStatuses": [200],
      "weight": 3
    },
    {
      "name": "analytics-data-quality",
      "method": "GET",
      "path": "/api/admin/v1/dashboard/analytics/data-quality?window=24h",
      "expectedStatuses": [200],
      "weight": 2
    },
    {
      "name": "withdrawal-reviews",
      "method": "GET",
      "path": "/api/admin/v1/withdrawal-reviews?page=1&pageSize=20",
      "expectedStatuses": [200],
      "weight": 2
    },
    {
      "name": "provider-services",
      "method": "GET",
      "path": "/api/admin/v1/provider-services?page=1&pageSize=20",
      "expectedStatuses": [200],
      "weight": 1
    }
  ]
}
