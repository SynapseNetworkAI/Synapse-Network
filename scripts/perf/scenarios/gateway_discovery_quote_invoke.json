{
  "name": "gateway-discovery-quote-invoke",
  "baseUrlEnv": "SYNAPSE_GATEWAY_BASE_URL",
  "headers": {
    "X-Credential": "${SYNAPSE_AGENT_CREDENTIAL}",
    "X-Owner-Address": "${SYNAPSE_OWNER_WALLET}"
  },
  "requests": [
    {
      "name": "service-discovery",
      "method": "GET",
      "path": "/api/v1/services/discover?page=1&pageSize=10",
      "expectedStatuses": [200],
      "weight": 4
    },
    {
      "name": "agent-invoke",
      "method": "POST",
      "path": "/api/v1/agent/invoke",
      "expectedStatuses": [200],
      "weight": 6,
      "body": {
        "serviceId": "${SYNAPSE_PERF_SERVICE_ID}",
        "idempotencyKey": "${SYNAPSE_PERF_REQUEST_ID_PREFIX}-invoke-{{random}}",
        "costUsdc": "0.000000",
        "payload": {
          "body": {
            "repoUrl": "https://github.com/cliff-personal/Synapse-Network"
          }
        }
      }
    }
  ]
}
