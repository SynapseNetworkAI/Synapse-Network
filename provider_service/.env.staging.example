# Provider Service staging 环境示例。
# 用法：
# 1. 复制为 provider_service/.env.staging
# 2. 使用 ./scripts/start.staging.sh 启动
# 3. staging 视作共享测试网环境，默认要求开启 Gateway 请求验签

SERVICE_HOST=0.0.0.0
SERVICE_PORT=8100

SENTIMENT_REPOSITORY_BACKEND=postgres
PROVIDER_SERVICE_POSTGRES_DSN=postgresql://synapse:change_me@postgres:5432/synapse_gateway_providers_staging

SENTIMENT_SCHEDULER_ENABLED=false
SENTIMENT_SCHEDULER_INTERVAL_S=30
SENTIMENT_PROXY_POOL_ENABLED=false
SENTIMENT_PROXY_POOL_URLS_JSON='[]'
SENTIMENT_PROXY_TIMEOUT_FLOOR_S=8

GATEWAY_PROVIDER_SIGNATURE_ENABLED=true
GATEWAY_PROVIDER_SIGNATURE_SECRET=replace-this-with-a-staging-provider-signature-secret

SOURCIFY_BASE_URL=https://sourcify.dev
SOURCIFY_TIMEOUT_S=6
BLOCKSCOUT_BASE_URLS_JSON='{"ethereum":"https://eth.blockscout.com/api","arbitrum":"https://arbitrum.blockscout.com/api","optimism":"https://optimism.blockscout.com/api","base":"https://base.blockscout.com/api"}'
BLOCKSCOUT_TIMEOUT_S=6
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ETHERSCAN_TIMEOUT_S=6
ETHERSCAN_API_KEY=

VIDEO_STORAGE_BACKEND=minio
VIDEO_STORAGE_MINIO_ENDPOINT=minio:9000
VIDEO_STORAGE_MINIO_ACCESS_KEY=minioadmin
VIDEO_STORAGE_MINIO_SECRET_KEY=minioadmin
VIDEO_STORAGE_MINIO_BUCKET=synapse-provider-assets-staging
VIDEO_STORAGE_MINIO_SECURE=false

TWITTER_X_API_BASE_URL=https://api.x.com
TWITTER_X_API_TIMEOUT_S=20
TWITTER_X_API_BEARER_TOKEN=
TWITTER_X_API_KEY=
TWITTER_X_API_SECRET=
TWITTER_X_API_USER_AGENT=synapse-provider-service

ALLOW_INSECURE_PROD_START=false
