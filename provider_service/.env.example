# DeepSeek API 访问密钥；当前情绪接口不是必填，未来接真实模型时才需要。必填：否。默认值：空。
DEEPSEEK_API_KEY=your_deepseek_api_key
# DeepSeek 服务基础地址。必填：否。默认值：https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 默认模型名。必填：否。默认值：deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
# DeepSeek 请求超时时间，单位秒。必填：否。默认值：30
DEEPSEEK_TIMEOUT_S=30
# Provider Service 监听地址。必填：否。默认值：0.0.0.0
SERVICE_HOST=0.0.0.0
# Provider Service 监听端口。必填：否。默认值：8100
SERVICE_PORT=8100
# 情绪数据存储后端；可选 file 或 postgres。必填：否。默认值：file
SENTIMENT_REPOSITORY_BACKEND=file
# file backend 的本地存储目录。仅在 SENTIMENT_REPOSITORY_BACKEND=file 时生效。必填：否。默认值：logs/sentiment
SENTIMENT_STORAGE_DIR=logs/sentiment
# Provider Service 共享数据库连接串；protocol brief repository 固定走 postgres，sentiment 若切 postgres 也复用它。必填：条件必填。默认值：空
PROVIDER_SERVICE_POSTGRES_DSN=postgresql://synapse:12345678@localhost:5432/synapse_gateway_providers
# 协议基本面情报包快照表名。必填：否。默认值：provider_protocol_briefs
PROTOCOL_BRIEF_POSTGRES_SNAPSHOT_TABLE=provider_protocol_briefs
# 协议基本面情报包原始抓取明细表名。必填：否。默认值：provider_protocol_brief_raw_feeds
PROTOCOL_BRIEF_POSTGRES_RAW_FEED_TABLE=provider_protocol_brief_raw_feeds
# 协议基本面情报包快照 TTL，单位秒；未过期时优先走内存/持久化缓存。必填：否。默认值：300
PROTOCOL_BRIEF_CACHE_TTL_S=300
# Provider 统一调用审计表名。必填：否。默认值：provider_api_invocations
PROVIDER_API_INVOCATION_TABLE=provider_api_invocations
# 巨鲸监控快照表名。必填：否。默认值：provider_whale_flow_snapshots
WHALE_FLOW_POSTGRES_SNAPSHOT_TABLE=provider_whale_flow_snapshots
# 巨鲸监控快照 TTL，单位秒。必填：否。默认值：600
WHALE_FLOW_CACHE_TTL_S=600
# OSS 体检报告快照表名。必填：否。默认值：provider_oss_security_reports
OSS_SECURITY_POSTGRES_REPORT_TABLE=provider_oss_security_reports
# OSS 体检报告快照 TTL，单位秒。必填：否。默认值：7200
OSS_SECURITY_CACHE_TTL_S=7200
# Twitter 视频资产表名。必填：否。默认值：provider_twitter_video_assets
TWITTER_VIDEO_POSTGRES_ASSET_TABLE=provider_twitter_video_assets
# Twitter 视频缓存 TTL，单位秒。必填：否。默认值：86400
TWITTER_VIDEO_CACHE_TTL_S=86400
# Twitter 视频下载临时目录。必填：否。默认值：storage/twitter_videos/tmp
TWITTER_VIDEO_TMP_DIR=storage/twitter_videos/tmp
# TikTok 视频资产表名。必填：否。默认值：provider_tiktok_video_assets
TIKTOK_VIDEO_POSTGRES_ASSET_TABLE=provider_tiktok_video_assets
# TikTok 视频缓存 TTL，单位秒。必填：否。默认值：86400
TIKTOK_VIDEO_CACHE_TTL_S=86400
# TikTok 视频下载临时目录。必填：否。默认值：storage/tiktok_videos/tmp
TIKTOK_VIDEO_TMP_DIR=storage/tiktok_videos/tmp
# YouTube 视频资产表名。必填：否。默认值：provider_youtube_video_assets
YOUTUBE_VIDEO_POSTGRES_ASSET_TABLE=provider_youtube_video_assets
# YouTube 视频缓存 TTL，单位秒。必填：否。默认值：86400
YOUTUBE_VIDEO_CACHE_TTL_S=86400
# YouTube 视频下载临时目录。必填：否。默认值：storage/youtube_videos/tmp
YOUTUBE_VIDEO_TMP_DIR=storage/youtube_videos/tmp
# Reddit 媒体资产表名。必填：否。默认值：provider_reddit_media_assets
REDDIT_MEDIA_POSTGRES_ASSET_TABLE=provider_reddit_media_assets
# Reddit 媒体缓存 TTL，单位秒。必填：否。默认值：86400
REDDIT_MEDIA_CACHE_TTL_S=86400
# Reddit 媒体下载临时目录。必填：否。默认值：storage/reddit_media/tmp
REDDIT_MEDIA_TMP_DIR=storage/reddit_media/tmp
# 视频存储后端。当前仅支持 minio。必填：否。默认值：minio
VIDEO_STORAGE_BACKEND=minio
# 视频对象 key 前缀。必填：否。默认值：twitter
VIDEO_STORAGE_KEY_PREFIX=twitter
# MinIO endpoint，例如 localhost:9000。必填：是（minio 模式）
VIDEO_STORAGE_MINIO_ENDPOINT=localhost:9000
# MinIO Access Key。必填：是（minio 模式）
VIDEO_STORAGE_MINIO_ACCESS_KEY=minioadmin
# MinIO Secret Key。必填：是（minio 模式）
VIDEO_STORAGE_MINIO_SECRET_KEY=minioadmin
# MinIO Bucket。必填：是（minio 模式）
VIDEO_STORAGE_MINIO_BUCKET=synapse-twitter-videos
# MinIO 是否使用 HTTPS。必填：否。默认值：false
VIDEO_STORAGE_MINIO_SECURE=false
# Alternative.me 单次请求超时时间，单位秒。必填：否。默认值：2
ALTERNATIVE_ME_TIMEOUT_S=2
# Binance 单次请求超时时间，单位秒。必填：否。默认值：1
BINANCE_TIMEOUT_S=1
# 是否开启抓取 worker 代理池。开启后情绪抓取请求会通过代理轮转出站。必填：否。默认值：false
SENTIMENT_PROXY_POOL_ENABLED=false
# 抓取 worker 代理池地址列表，JSON 数组格式；仅在 SENTIMENT_PROXY_POOL_ENABLED=true 时必填。必填：条件必填。默认值：空字符串
SENTIMENT_PROXY_POOL_URLS_JSON='["http://proxy-a.internal:8080","http://proxy-b.internal:8080"]'
# 代理链路超时时间下限，单位秒；开启代理池时会用它兜住过低的单源 timeout。
SENTIMENT_PROXY_TIMEOUT_FLOOR_S=8
# 单个情绪数据源最大重试次数。必填：否。默认值：2
SENTIMENT_SOURCE_MAX_ATTEMPTS=2
# 数据源重试退避基础时间，单位毫秒。必填：否。默认值：200
SENTIMENT_SOURCE_BACKOFF_MS=200
# 聚合快照表名。必填：否。默认值：provider_sentiment_snapshots
SENTIMENT_POSTGRES_SNAPSHOT_TABLE=provider_sentiment_snapshots
# 原始抓取明细表名。必填：否。默认值：provider_sentiment_raw_feeds
SENTIMENT_POSTGRES_RAW_FEED_TABLE=provider_sentiment_raw_feeds
# Scheduler 状态表名。必填：否。默认值：provider_sentiment_scheduler_jobs
SENTIMENT_POSTGRES_SCHEDULER_JOB_TABLE=provider_sentiment_scheduler_jobs
# 是否开启后台 scheduler。必填：否。默认值：false
SENTIMENT_SCHEDULER_ENABLED=false
# Scheduler 轮询周期，单位秒。必填：否。默认值：30
SENTIMENT_SCHEDULER_INTERVAL_S=30
# Scheduler 同时允许刷新的快照数量上限。必填：否。默认值：2
SENTIMENT_SCHEDULER_MAX_CONCURRENT_SNAPSHOTS=2
# 单个快照 lease 持有时长，单位秒。必填：否。默认值：120
SENTIMENT_SCHEDULER_LEASE_TTL_S=120
# Scheduler 白名单目标；留空时走内置热点列表。必填：否。默认值：空字符串
SENTIMENT_SCHEDULER_TARGETS_JSON=
# 新鲜快照阈值，单位秒。必填：否。默认值：60
SENTIMENT_SCHEDULER_FRESH_TTL_S=60
# 可服务但偏旧的快照阈值，单位秒。必填：否。默认值：300
SENTIMENT_SCHEDULER_STALE_TTL_S=300
# 必须同步重抓的硬过期阈值，单位秒。必填：否。默认值：900
SENTIMENT_SCHEDULER_HARD_EXPIRE_S=900
# 是否开启 Gateway 请求验签。生产必须开启；本地调试可按需关闭。必填：否。默认值：true
GATEWAY_PROVIDER_SIGNATURE_ENABLED=true
# Gateway -> Provider HMAC 验签密钥；仅在 GATEWAY_PROVIDER_SIGNATURE_ENABLED=true 时必填。必填：条件必填。默认值：replace-this-with-a-provider-signature-secret
GATEWAY_PROVIDER_SIGNATURE_SECRET=replace-this-with-a-provider-signature-secret
# 仅用于紧急放行 prod 关闭验签启动；默认拒绝启动 prod + signature_disabled。必填：否。默认值：false
ALLOW_INSECURE_PROD_START=false
