# Synapse-Network local operator config.
# Copy to env.local for local-only plain configuration. Do not commit env.local.
#
# Keep credentials in Secret Manager or service-local private files, not here:
# POSTGRES_DSN, POSTGRES_PASSWORD, POSTGRES_MIGRATOR_PASSWORD, JWT_SECRET,
# AUTH_SECRET, GATEWAY_INTERNAL_JWT_SECRET, ADMIN_*_SECRET, *_DATABASE_DSN,
# GMAIL_SMTP_APP_PASSWORD, TRANSACTION_LARK_SECRET, *_API_KEY, private keys,
# wallet private keys, provider owner private keys, and KMS signer material.

SYNAPSE_ENV=local
ENVIRONMENT=local
NODE_ENV=development

PUBLIC_APP_BASE_URL=http://127.0.0.1:3000
PUBLIC_GATEWAY_BASE_URL=http://127.0.0.1:8000
PUBLIC_ADMIN_BASE_URL=http://127.0.0.1:3001
PUBLIC_ADMIN_API_BASE_URL=http://127.0.0.1:8100
PUBLIC_DOCS_BASE_URL=http://127.0.0.1:3002
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_GATEWAY_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://127.0.0.1:8100
NEXT_PUBLIC_DOCS_BASE_URL=http://127.0.0.1:3002
NEXT_PUBLIC_CONSOLE_BASE_URL=http://127.0.0.1:3000/dashboard/overview
NEXT_PUBLIC_TX_EXPLORER_BASE_URL=https://sepolia.arbiscan.io
ADMIN_API_PROXY_TARGET=http://127.0.0.1:8100

CHAIN_ID=421614
CHAIN_NAME=arbitrum-sepolia
ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
USDC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
WITHDRAW_SIGNER_MODE=local_private_key
WITHDRAW_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
PLATFORM_FEE_ADMIN_WALLETS=0x0000000000000000000000000000000000000000
INDEXER_ADMIN_WALLETS=0x0000000000000000000000000000000000000000

STORAGE_BACKEND=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=synapse
POSTGRES_USER=synapse_gateway_app
POSTGRES_CONNECT_TIMEOUT_SEC=5
POSTGRES_POOL_MAX=5
POSTGRES_AUTO_INIT=0

V2_INDEXER_ENABLED=false
PROVIDER_WITHDRAW_EXPIRY_REAPER_ENABLED=false
CONSUMER_WITHDRAW_PROCESSOR_ENABLED=false
CONSUMER_WITHDRAW_CHAIN_RECOVERY_ENABLED=false
WITHDRAWAL_EXPIRY_SWEEPER_ENABLED=false
WITHDRAWAL_AUTO_SINGLE_LIMIT_USDC=1.000000
WITHDRAWAL_TIMEOUT_ALERT_AFTER_SEC=900

ANALYTICS_TRANSPORT=outbox
ANALYTICS_STRICT_KAFKA=false
ANALYTICS_KAFKA_BOOTSTRAP_SERVERS=
DOWNSTREAM_ADAPTIVE_REDIS_ENABLED=false
REDIS_URL=

EMAIL_OUTBOX_ENABLED=false
EMAIL_TRANSPORT=log
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
EMAIL_FROM=Synapse Network Local <local-alerts@synapse-network.ai>
EMAIL_REPLY_TO=support@synapse-network.ai

GATEWAY_PROVIDER_SIGNATURE_ENABLED=true
GATEWAY_PROVIDER_SIGNATURE_MAX_SKEW_S=300
NOTIFICATION_OUTBOX_TRIGGER_ENABLED=false
NOTIFICATION_OUTBOX_TRIGGER_URL=http://127.0.0.1:8000/internal/jobs/notification-outbox/trigger
NOTIFICATION_OUTBOX_TRIGGER_TIMEOUT_SEC=3
NOTIFICATION_OUTBOX_FALLBACK_ENABLED=true
TRANSACTION_LARK_ENABLED=false
IN_APP_NOTIFICATION_CLEANUP_ENABLED=false
STAGING_ALERT_DRILL_ENABLED=false

PROVIDER_ENV=local
PROVIDER_RUNTIME_ROLE=runtime
PROVIDER_PUBLIC_BASE_URL=http://127.0.0.1:8300
PROVIDER_GATEWAY_REGISTRATION_EXPECTED=false
PROVIDER_PUBLIC_DOCS_ENABLED=false
PROVIDER_STAGING_ENABLED_SERVICES_JSON=[]
PROVIDER_MAX_BODY_BYTES=131072
PROVIDER_MAX_RESPONSE_BYTES=1048576
PROVIDER_GLOBAL_QPS=5
PROVIDER_SERVICE_QPS_JSON={}
