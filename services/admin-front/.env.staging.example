# Admin-front staging environment.
# All browser-facing URLs must include https://.

# Browser-side Admin API base URL.
NEXT_PUBLIC_ADMIN_API_BASE_URL=https://admin-api-staging.synapse-network.ai

# Next.js rewrite target for /api/admin/* when server-side proxying is used.
ADMIN_API_PROXY_TARGET=https://admin-api-staging.synapse-network.ai

# Public environment marker used by frontend UI/docs.
NEXT_PUBLIC_APP_ENV=staging
