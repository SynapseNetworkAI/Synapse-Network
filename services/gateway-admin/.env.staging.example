# ============================================================
# Synapse gateway-admin staging 环境模板配置
# 文件用途：Google Cloud staging / Cloud Run / Cloud SQL 模板
# 推荐做法：复制为 .env.staging 或部署机私有 env 文件，再通过 ADMIN_GATEWAY_ENV_FILE 指定
# 真实 secret 一律来自 Secret Manager；不要提交真实值。
# ============================================================

# Runtime environment name. Staging must be "staging".
ENVIRONMENT=staging

ADMIN_GATEWAY_HOST=0.0.0.0
ADMIN_GATEWAY_PORT=8000
ADMIN_GATEWAY_DEBUG=false

# 内部 Prometheus 抓取令牌；Ingress / LB 必须同时限制公网访问 /metrics。
# 当前复用 staging metrics token。
METRICS_BEARER_TOKEN=replace-with-secret-manager-synapse-staging-metrics-bearer-token
METRICS_BASIC_USERNAME=
METRICS_BASIC_PASSWORD=
ADMIN_GATEWAY_ALLOWED_ORIGINS=https://admin-staging.synapse-network.ai
ADMIN_GATEWAY_TOKEN_PREFIX=adm_stg_

ADMIN_SESSION_TTL_SEC=3600
ADMIN_SESSION_COOKIE_NAME=synapse_admin_session
ADMIN_SESSION_COOKIE_SECURE=true
ADMIN_SESSION_COOKIE_SAMESITE=lax
ADMIN_SESSION_COOKIE_DOMAIN=.synapse-network.ai
ADMIN_CSRF_SECRET=replace-with-secret-manager-synapse-staging-admin-csrf-secret

ADMIN_GOOGLE_AUTHENTICATOR_LOGIN_ENABLED=true
ADMIN_GOOGLE_AUTHENTICATOR_HIGH_RISK_ENABLED=true
ADMIN_GOOGLE_AUTHENTICATOR_ISSUER="Synapse Gateway Admin (Staging)"
ADMIN_GOOGLE_AUTHENTICATOR_WINDOW=1
ADMIN_LOGIN_LOCK_THRESHOLD=5
ADMIN_LOGIN_LOCK_HOURS=24

# Full DSN secrets are injected by Cloud Run. Do not try to compose DB passwords
# inside Terraform variables because Secret Manager cannot safely interpolate
# substrings into an env var.
ADMIN_DATABASE_DSN=replace-with-secret-manager-synapse-staging-admin-database-dsn
ADMIN_DATABASE_MIGRATION_DSN=replace-with-secret-manager-synapse-staging-admin-database-migration-dsn
GATEWAY_READONLY_DSN=replace-with-secret-manager-synapse-staging-gateway-readonly-dsn
GATEWAY_FORUM_WRITE_DSN=replace-with-secret-manager-synapse-staging-gateway-forum-write-dsn
GATEWAY_INTERNAL_BASE_URL=https://api-staging.synapse-network.ai
GATEWAY_INTERNAL_ADMIN_WALLET=replace-with-secret-manager-synapse-staging-gateway-admin-wallet
GATEWAY_INTERNAL_JWT_SECRET=replace-with-secret-manager-synapse-staging-gateway-internal-jwt-secret
GATEWAY_INTERNAL_TOKEN_ISSUER=gateway-admin
GATEWAY_INTERNAL_TOKEN_AUDIENCE=gateway-internal
GATEWAY_INTERNAL_SERVICE_SUBJECT=service:gateway-admin
GATEWAY_INTERNAL_TIMEOUT_SEC=10

# Keep the API service free of long-running loops. Move workers to jobs once
# the admin control plane needs background execution processing.
EXECUTION_WORKER_ENABLED=false
EXECUTION_WORKER_POLL_INTERVAL_SEC=5
EXECUTION_WORKER_BATCH_SIZE=20
