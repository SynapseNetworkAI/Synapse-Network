# ============================================================
# Synapse gateway-admin 生产环境模板配置
# 文件用途：生产 / 预发 / 云主机部署的模板，不建议直接拿示例值上线
# 推荐做法：复制为部署机私有 env 文件，再通过 ADMIN_GATEWAY_ENV_FILE 指定
# ============================================================

# 运行环境名称。
# 作用：建议共享测试网固定为 staging，正式生产固定为 prod，避免 local 的默认宽松行为生效。
environment=prod

# 服务监听地址。
# 作用：生产通常监听 0.0.0.0，由 Nginx / LB / Ingress 做前置入口。
ADMIN_GATEWAY_HOST=0.0.0.0

# 服务监听端口。
# 作用：生产容器或主机上 gateway-admin 的服务端口。
ADMIN_GATEWAY_PORT=8300

# 是否开启调试模式。
# 作用：生产必须关闭，防止暴露调试信息与额外日志噪音。
ADMIN_GATEWAY_DEBUG=false

# 内部 Prometheus 抓取令牌；/metrics 还必须由代理层限制为私网来源。
METRICS_BEARER_TOKEN=replace-with-admin-metrics-token
METRICS_BASIC_USERNAME=
METRICS_BASIC_PASSWORD=

# 允许跨域访问的后台前端域名，多个值用英文逗号分隔。
# 作用：生产只应保留真实后台域名，不要保留 localhost。
ADMIN_GATEWAY_ALLOWED_ORIGINS=https://admin.synapse.network

# 管理员令牌前缀。
# 作用：用于生成和识别 admin token，建议保持稳定前缀，便于审计检索。
ADMIN_GATEWAY_TOKEN_PREFIX=adm_prod_

# 后台 session TTL，单位秒。
# 作用：控制登录成功后后台 HttpOnly 会话的有效时间。
ADMIN_SESSION_TTL_SEC=3600

# 后台 session cookie 名称。
# 作用：生产前后端通过该 cookie 识别管理员会话。
ADMIN_SESSION_COOKIE_NAME=synapse_admin_session

# 是否对 session cookie 强制 Secure。
# 作用：生产必须为 true，确保 cookie 只经由 HTTPS 传输。
ADMIN_SESSION_COOKIE_SECURE=true

# session cookie SameSite 策略。
# 作用：admin 前端和后台通常同站部署，推荐保持 lax。
ADMIN_SESSION_COOKIE_SAMESITE=lax

# session cookie 域名。
# 作用：当 admin 前端和 API 走同一父域时，可设为 .synapse.network 统一作用域。
ADMIN_SESSION_COOKIE_DOMAIN=.synapse.network

# 管理后台 CSRF 密钥。
# 作用：签发会话绑定的 csrfToken，必须替换为 32 字节以上随机高强度密钥。
ADMIN_CSRF_SECRET=replace-with-production-admin-csrf-secret

# 是否开启登录 TOTP 校验。
# 作用：已绑定账号登录时是否必须带 Google Authenticator 6 位码。
ADMIN_GOOGLE_AUTHENTICATOR_LOGIN_ENABLED=true

# 是否开启高风险操作 TOTP 二次校验。
# 作用：审批、重试、发布等高风险操作是否强制 step-up。
ADMIN_GOOGLE_AUTHENTICATOR_HIGH_RISK_ENABLED=true

# Google Authenticator issuer。
# 作用：二维码和手工 key 对终端用户展示的发行方名称。
ADMIN_GOOGLE_AUTHENTICATOR_ISSUER="Synapse Gateway Admin"

# Google Authenticator 校验时间窗。
# 作用：允许轻微设备时钟偏移；生产通常保持 1 即可。
ADMIN_GOOGLE_AUTHENTICATOR_WINDOW=1

# gateway-admin 自身控制面数据库 DSN。
# 作用：生产后台控制面真相库存储地址；必须使用专用账号，不与 gateway 主写账号混用。
ADMIN_DATABASE_DSN=postgresql://synapse_admin_app:REPLACE_STRONG_PASSWORD@admin-postgres:5432/synapse_gateway_admin

# gateway-admin schema migration DSN。
# 作用：仅用于手工执行 scripts/apply_migrations.py 补齐 admin bootstrap SQL，需要具备 schema CREATE / ALTER 权限；默认可与 ADMIN_DATABASE_DSN 相同，但旧库补表时通常要换成 schema owner 或 superuser。
ADMIN_DATABASE_MIGRATION_DSN=postgresql://synapse_admin_migrator:REPLACE_STRONG_PASSWORD@admin-postgres:5432/synapse_gateway_admin

# gateway 主库只读连接 DSN。
# 作用：只读查询 gateway 指标与 projection，必须使用只读账号，禁止给写权限。
GATEWAY_READONLY_DSN=postgresql://synapse_gateway_ro:REPLACE_STRONG_PASSWORD@gateway-postgres:5432/synapse_gateway

# gateway 内部管理接口基础地址。
# 作用：供 execution worker 和后台受控命令回调 gateway 管理接口。
GATEWAY_INTERNAL_BASE_URL=https://gateway-internal.synapse.network

# gateway 内部管理钱包地址。
# 作用：作为内部 JWT 的管理员主体，必须与 gateway 侧受信配置一致。
GATEWAY_INTERNAL_ADMIN_WALLET=0xReplaceWithProductionGatewayAdminWallet

# gateway 内部管理 JWT 密钥。
# 作用：用于签发 admin -> gateway 内部管理 JWT；必须使用 32 字节以上高强度随机密钥。
GATEWAY_INTERNAL_JWT_SECRET=replace-with-production-32-byte-minimum-jwt-secret

# gateway 内部管理 JWT issuer。
# 作用：与 gateway 侧白名单配置保持一致，标识 token 签发方。
GATEWAY_INTERNAL_TOKEN_ISSUER=gateway-admin

# gateway 内部管理 JWT audience。
# 作用：限制内部 token 只被 gateway internal 接口接受。
GATEWAY_INTERNAL_TOKEN_AUDIENCE=gateway-internal

# gateway 内部管理 JWT subject。
# 作用：标记当前服务身份，建议使用 service:gateway-admin。
GATEWAY_INTERNAL_SERVICE_SUBJECT=service:gateway-admin

# 调用 gateway 内部接口的超时时间，单位秒。
# 作用：防止后台任务在网络抖动或 gateway 异常时长期阻塞。
GATEWAY_INTERNAL_TIMEOUT_SEC=10

# 是否开启 execution worker。
# 作用：生产通常应开启，让 execution jobs 自动推进；仅在外部调度器接管时才关闭。
EXECUTION_WORKER_ENABLED=true

# execution worker 轮询间隔，单位秒。
# 作用：生产可按任务量调优，值越小越实时，值越大越省资源。
EXECUTION_WORKER_POLL_INTERVAL_SEC=5

# execution worker 单次批处理数量。
# 作用：限制单次拉取的任务规模，避免一轮任务把后台拖慢。
EXECUTION_WORKER_BATCH_SIZE=20

# 是否启用内存存储模式。
# 作用：生产必须为 false；若设为 true，会绕开 PostgreSQL，不满足控制面持久化要求。
