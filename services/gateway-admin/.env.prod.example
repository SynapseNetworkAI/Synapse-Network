# ============================================================
# Synapse gateway-admin 明确 prod 模板配置
# 文件用途：生产部署时的私有环境变量模板，请复制后按真实密钥与域名替换
# 启动方式：ADMIN_GATEWAY_ENV_FILE=/etc/synapse/gateway-admin.env sh scripts/ops/start-prod.sh
# ============================================================

environment=prod

ADMIN_GATEWAY_HOST=0.0.0.0
ADMIN_GATEWAY_PORT=8300
ADMIN_GATEWAY_DEBUG=false
ADMIN_GATEWAY_ALLOWED_ORIGINS=https://admin.synapse.network
ADMIN_GATEWAY_TOKEN_PREFIX=adm_prod_

ADMIN_SESSION_TTL_SEC=3600
ADMIN_SESSION_COOKIE_NAME=synapse_admin_session
ADMIN_SESSION_COOKIE_SECURE=true
ADMIN_SESSION_COOKIE_SAMESITE=lax
ADMIN_SESSION_COOKIE_DOMAIN=.synapse.network
ADMIN_CSRF_SECRET=replace-with-production-admin-csrf-secret

ADMIN_GOOGLE_AUTHENTICATOR_LOGIN_ENABLED=true
ADMIN_GOOGLE_AUTHENTICATOR_HIGH_RISK_ENABLED=true
ADMIN_GOOGLE_AUTHENTICATOR_ISSUER="Synapse Gateway Admin"
ADMIN_GOOGLE_AUTHENTICATOR_WINDOW=1

ADMIN_DATABASE_DSN=postgresql://synapse_admin_app:REPLACE_STRONG_PASSWORD@admin-postgres:5432/synapse_gateway_admin
ADMIN_DATABASE_MIGRATION_DSN=postgresql://synapse_admin_migrator:REPLACE_STRONG_PASSWORD@admin-postgres:5432/synapse_gateway_admin

GATEWAY_READONLY_DSN=postgresql://synapse_gateway_ro:REPLACE_STRONG_PASSWORD@gateway-postgres:5432/synapse_gateway
GATEWAY_INTERNAL_BASE_URL=https://gateway-internal.synapse.network
GATEWAY_INTERNAL_ADMIN_WALLET=0xReplaceWithProductionGatewayAdminWallet
GATEWAY_INTERNAL_JWT_SECRET=replace-with-production-32-byte-minimum-jwt-secret
GATEWAY_INTERNAL_TOKEN_ISSUER=gateway-admin
GATEWAY_INTERNAL_TOKEN_AUDIENCE=gateway-internal
GATEWAY_INTERNAL_SERVICE_SUBJECT=service:gateway-admin
GATEWAY_INTERNAL_TIMEOUT_SEC=10

EXECUTION_WORKER_ENABLED=true
EXECUTION_WORKER_POLL_INTERVAL_SEC=5
EXECUTION_WORKER_BATCH_SIZE=20
