# ============================================================
# Synapse gateway-admin 本地开发环境配置
# 文件用途：本机开发 / 联调 / 单机运维验证
# 启动方式：默认被 scripts/ops/start-local.sh 自动加载
# 注意：该文件只适合 local，不适合直接用于生产
# ============================================================

# 运行环境名称。
# 作用：控制配置分支与 development 下的额外 CORS 放宽逻辑。
environment=development

# 服务监听地址。
# 作用：决定 uvicorn 绑定在哪个网卡；本地联调用 0.0.0.0 即可。
ADMIN_GATEWAY_HOST=0.0.0.0

# 服务监听端口。
# 作用：gateway-admin 对外暴露的 HTTP 端口。
ADMIN_GATEWAY_PORT=8300

# 是否开启调试模式。
# 作用：本地开发可保留 true，方便排错；生产必须关闭。
ADMIN_GATEWAY_DEBUG=true

# 允许跨域访问的前端来源，多个值用英文逗号分隔。
# 作用：控制管理后台前端、本地调试页是否能访问本服务。
ADMIN_GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000

# 管理员令牌前缀。
# 作用：区分 admin token 与其他系统 token，便于审计和前缀校验。
ADMIN_GATEWAY_TOKEN_PREFIX=adm_demo_

# 后台 session TTL，单位秒。
# 作用：控制登录成功后 HttpOnly 管理员 cookie 的有效时长。
ADMIN_SESSION_TTL_SEC=3600

# 后台 session cookie 名称。
# 作用：admin-front 和 gateway-admin 通过它识别管理员会话 cookie。
ADMIN_SESSION_COOKIE_NAME=synapse_admin_session

# 是否对 session cookie 强制 Secure。
# 作用：local http 联调必须为 false；生产 HTTPS 必须为 true。
ADMIN_SESSION_COOKIE_SECURE=false

# session cookie SameSite 策略。
# 作用：控制跨站请求时 cookie 的携带策略；本地同站前后端通常使用 lax。
ADMIN_SESSION_COOKIE_SAMESITE=lax

# session cookie 作用域域名。
# 作用：本地通常留空；生产可设为 admin 域名或父域，便于子域共享。
ADMIN_SESSION_COOKIE_DOMAIN=

# 管理后台 CSRF 密钥。
# 作用：签发和校验会话绑定的 csrfToken；local 可以用测试值，prod 必须替换成高强度随机密钥。
ADMIN_CSRF_SECRET=0_n5om6N-8trX5HRd1c-0ijIU--KafzR

# 是否开启登录时 Google Authenticator 校验。
# 作用：已绑定 MFA 的管理员登录时是否必须提交 otpCode。
ADMIN_GOOGLE_AUTHENTICATOR_LOGIN_ENABLED=true

# 是否开启高风险操作 Google Authenticator 二次校验。
# 作用：approval / execution retry / publish 等高风险写操作是否要求 X-Admin-OTP-Code。
ADMIN_GOOGLE_AUTHENTICATOR_HIGH_RISK_ENABLED=true

# Google Authenticator issuer。
# 作用：首次绑定 MFA 时二维码和手工 key 上展示的发行方名称。
ADMIN_GOOGLE_AUTHENTICATOR_ISSUER="Local Synapse Gateway Admin "

# Google Authenticator 校验时间窗。
# 作用：允许前后各多少个 30 秒窗口，缓解设备时间轻微漂移。
ADMIN_GOOGLE_AUTHENTICATOR_WINDOW=1

# gateway-admin 自身控制面数据库 DSN。
# 作用：存储后台用户、菜单配置、审批流、执行任务、管理员审计等数据。
ADMIN_DATABASE_DSN=postgresql://synapse_admin_app:local-dev-admin-app-password@127.0.0.1:15432/synapse_gateway_admin

# gateway-admin migration 数据库 DSN。
# 作用：手工执行 scripts/apply_migrations.py 时使用；本地 start_all_services 会先用 migrator，旧 volume 权限不足时再 fallback 到 Docker Postgres owner。
ADMIN_DATABASE_MIGRATION_DSN=postgresql://synapse_admin_migrator:local-dev-admin-migrator-password@127.0.0.1:15432/synapse_gateway_admin

# gateway 主库只读连接 DSN。
# 作用：读取 gateway 侧 projection / dashboard 数据，禁止写 gateway 真相表。
GATEWAY_READONLY_DSN=postgresql://synapse_gateway_ro:local-dev-gateway-readonly-password@127.0.0.1:15432/synapse_gateway

# gateway 内部管理接口基础地址。
# 作用：execution worker 或后台受控操作回调 gateway 内部管理端点。
GATEWAY_INTERNAL_BASE_URL=http://localhost:8000

# gateway 内部管理钱包地址。
# 作用：生成内部管理员 JWT 时作为管理员身份主体，驱动受控内部操作。
GATEWAY_INTERNAL_ADMIN_WALLET=0xA0f67a47D9eF18183Cd113eD85A654E2772c5901

# gateway 内部管理 JWT 密钥。
# 作用：签发 gateway-admin -> gateway 的内部管理 JWT；本地可测试值，生产必须替换为高强度密钥。
GATEWAY_INTERNAL_JWT_SECRET=pfazKmMdEZ8RCTB-8A_hH9AAknSXoP6y

# gateway 内部管理 JWT issuer。
# 作用：标记内部 service token 的签发方，需与 gateway 侧受信配置一致。
GATEWAY_INTERNAL_TOKEN_ISSUER=gateway-admin

# gateway 内部管理 JWT audience。
# 作用：限制 token 只能被 gateway internal 接口接受，避免被其他服务误用。
GATEWAY_INTERNAL_TOKEN_AUDIENCE=gateway-internal

# gateway 内部管理 JWT subject。
# 作用：声明当前后台服务身份，便于 gateway 区分人类 owner token 和后台 service token。
GATEWAY_INTERNAL_SERVICE_SUBJECT=service:gateway-admin

# 调用 gateway 内部接口的超时时间，单位秒。
# 作用：限制 execution worker 或后台命令等待 gateway 返回的最长时间，避免后台线程卡死。
GATEWAY_INTERNAL_TIMEOUT_SEC=10

# 是否开启 execution worker。
# 作用：本地联调时通常开启，使待执行 job 自动被扫描并推进。
EXECUTION_WORKER_ENABLED=true

# execution worker 轮询间隔，单位秒。
# 作用：控制后台扫描待执行任务的频率；值越小响应越快，但轮询压力越高。
EXECUTION_WORKER_POLL_INTERVAL_SEC=5

# execution worker 单次批处理数量。
# 作用：控制每轮最多拉取多少个待执行 job，避免单次批量过大拖慢后台。
EXECUTION_WORKER_BATCH_SIZE=10

# 是否启用内存存储模式。
# 作用：仅用于无数据库的临时演示 / 极简调试；正常 local 联调与所有生产环境都应为 false。

GATEWAY_FORUM_WRITE_DSN=postgresql://synapse_gateway_app:local-dev-gateway-app-password@127.0.0.1:15432/synapse_gateway
