# 通用前端环境变量模板。
# 推荐：
# 1. 本地复制成 .env.local
# 2. 共享测试网复制成 .env.staging
# 3. 正式公网复制成 .env.prod

NEXT_PUBLIC_GATEWAY_BASE_URL=https://gateway.demo.your-domain.example
NEXT_PUBLIC_SERVICE_LIST_CACHE_TTL_MS=20000
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.example
NEXT_PUBLIC_SUPPORT_PORTAL_URL=

# Optional: enable WalletConnect / Reown in staging / production.
# Configure one of the two keys below when you need mobile wallet support.
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
