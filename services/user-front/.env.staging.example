# User-front staging points to the public Gateway API.
# Must include https:// because staging is HTTPS-only.
NEXT_PUBLIC_GATEWAY_BASE_URL=https://api-staging.synapse-network.ai
NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://api-staging.synapse-network.ai/api/v1/events
NEXT_PUBLIC_SERVICE_LIST_CACHE_TTL_MS=20000
NEXT_PUBLIC_APP_ENV=staging

# User-facing support contact. Keep this as a public, non-secret address.
NEXT_PUBLIC_SUPPORT_EMAIL=support@synapse-network.ai
NEXT_PUBLIC_SUPPORT_PORTAL_URL=

# Optional mobile wallet support. Configure only when WalletConnect/Reown is enabled.
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
