# ==================================================
# Synapse Gateway 环境变量总模板
# 说明：
# 1. 这是网关支持配置的总清单，按“必须显式配置 / 可留默认”做中文说明。
# 2. 真正生效的默认值以 gateway/src/core/config.py 为准。
# 3. 建议本地使用 .env.local，共享测试网使用 .env.staging，正式生产使用 .env.prod；除非你知道原因，否则不要直接改本文件。
# ==================================================

# --------------------------------------------------
# 一、启动与环境选择
# --------------------------------------------------

# 运行环境标识。
# 是否必须显式配置：建议显式配置。
# 可选值：local / staging / prod / development / dev / production / stage / test。
ENVIRONMENT=local

# 显式指定要加载的环境文件；留空时，代码会根据 ENVIRONMENT 自动加载 .env.local / .env.prod 等文件。
# 是否必须显式配置：否，通常留空。
# 默认行为：自动按 ENVIRONMENT 选择环境文件。
ENV_FILE=

# --------------------------------------------------
# 二、链上与充值对账相关
# --------------------------------------------------

# 链上 RPC 地址，充值索引器、回填、对账都依赖它。
# 是否必须显式配置：是。
RPC_URL=http://127.0.0.1:8545

# SynapseCore / vault / router 合约地址。
# 是否必须显式配置：生产环境必须；本地如果 services/user-front/src/contract-config.json 存在且正确，可不写。
ROUTER_ADDRESS=0x0000000000000000000000000000000000000000

# USDC 代币合约地址，用于读取金库链上余额。
# 是否必须显式配置：生产环境必须；本地如果 services/user-front/src/contract-config.json 存在且正确，可不写。
USDC_TOKEN_ADDRESS=

# Gateway withdraw signer 私钥，用于签发 EIP-712 withdrawal ticket。
# 是否必须显式配置：如果你要启用 Provider 提现，则必须配置。
# 推荐来源：本地环境使用本地链测试账户；生产环境使用独立签名账户并通过 Secret Manager / KMS / HSM 注入。
# 安全要求：禁止把个人主钱包助记词直接写入配置。
PRIVATE_KEY=0xYourWithdrawSignerPrivateKey

# 充值到账前要求的区块确认数。
# 是否必须显式配置：否。
# 默认值：1。
V2_DEPOSIT_CONFIRMATIONS=1

# V2 索引器轮询间隔，单位秒。
# 是否必须显式配置：否。
# 默认值：2。
V2_INDEXER_POLL_INTERVAL_SEC=2

# 预留的区块批处理大小，给后续索引扩展使用。
# 是否必须显式配置：否。
# 默认值：100。
V2_INDEXER_BLOCK_BATCH=100

# 是否启用充值事件回填扫描。
# 是否必须显式配置：否。
# 默认值：1。
V2_BACKFILL_ENABLED=1

# 每轮回填扫描的区块数。
# 是否必须显式配置：否。
# 默认值：200。
V2_BACKFILL_BLOCK_BATCH=200

# 回填起始区块；填 0 表示自动决定起点。
# 是否必须显式配置：否。
# 默认值：0。
V2_BACKFILL_START_BLOCK=0

# 是否启用链上金库与账本义务的对账。
# 是否必须显式配置：否。
# 默认值：1。
V2_RECONCILIATION_ENABLED=1

# 对账最小执行间隔，单位秒。
# 是否必须显式配置：否。
# 默认值：30。
V2_RECONCILIATION_INTERVAL_SEC=30

# 对账告警阈值，单位 USDC；绝对差额超过它会触发告警。
# 是否必须显式配置：否。
# 默认值：1.0。
V2_RECONCILIATION_ALERT_DELTA_USDC=1.0

# --------------------------------------------------
# 三、存储与数据库
# --------------------------------------------------

# 存储后端；当前代码只支持 postgres。
# 是否必须显式配置：建议显式配置。
STORAGE_BACKEND=postgres

# PostgreSQL 主机地址。
# 是否必须显式配置：当你不写 POSTGRES_DSN 时才需要。
# 默认值：postgres。
POSTGRES_HOST=postgres

# PostgreSQL 端口。
# 是否必须显式配置：否。
# 默认值：5432。
POSTGRES_PORT=5432

# PostgreSQL 用户名。
# 是否必须显式配置：当你不写 POSTGRES_DSN 时才需要。
# 默认值：synapse。
POSTGRES_USER=synapse

# PostgreSQL 密码；如果同时写了 POSTGRES_DSN，这个值会覆盖 DSN 中的密码段。
# 是否必须显式配置：是，除非 DSN 已内嵌正确密码且不想覆盖。
POSTGRES_PASSWORD=

# PostgreSQL 数据库名。
# 是否必须显式配置：当你不写 POSTGRES_DSN 时才需要。
# 默认值：synapse_gateway。
POSTGRES_DB=synapse_gateway

# PostgreSQL 连接串；与 POSTGRES_HOST/PORT/USER/PASSWORD/DB 二选一即可，实际部署更推荐直接写这个。
# 是否必须显式配置：是，除非你完整配置了上面的分段字段。
POSTGRES_DSN=postgresql://synapse:change_me@127.0.0.1:5432/synapse_gateway

# 启动时是否自动初始化 PostgreSQL 表结构。
# 是否必须显式配置：否。
# 默认值：1。
# 生产建议：正式迁移完成后改成 0。
POSTGRES_AUTO_INIT=1

# --------------------------------------------------
# 四、认证与安全
# --------------------------------------------------

# JWT 签名密钥，所有 API 鉴权令牌依赖它。
# 是否必须显式配置：是。
JWT_SECRET=replace-this-with-a-32-byte-minimum-jwt-secret

# 钱包 challenge / auth 相关密钥；不填时默认继承 JWT_SECRET。
# 是否必须显式配置：建议显式配置。
AUTH_SECRET=replace-this-with-a-32-byte-minimum-jwt-secret

# 登录令牌有效期，单位秒。
# 是否必须显式配置：否。
# 默认值：86400。
AUTH_TOKEN_TTL_SEC=86400

# 钱包签名 challenge 有效期，单位秒。
# 是否必须显式配置：否。
# 默认值：600。
AUTH_CHALLENGE_TTL_SEC=600

# 金融幂等记录保留时长，单位秒。
# 是否必须显式配置：否。
# 默认值：86400。
FINANCE_IDEMPOTENCY_TTL_SEC=86400

# 幂等表最多保留条数，超出后会清理。
# 是否必须显式配置：否。
# 默认值：10000。
FINANCE_IDEMPOTENCY_MAX_ROWS=10000

# 充值 / 退款重放保护窗口，单位秒。
# 是否必须显式配置：否。
# 默认值：900。
FINANCE_REPLAY_WINDOW_SEC=900

# 财务写接口每分钟限流。
# 是否必须显式配置：否。
# 默认值：60。
FINANCE_WRITE_RATE_LIMIT_PER_MIN=60

# --------------------------------------------------
# 五、凭据、限流与平台硬阈值
# --------------------------------------------------

# 新建调用凭据的默认有效期，单位秒。
# 是否必须显式配置：否。
# 默认值：3600。
AGENT_CREDENTIAL_DEFAULT_TTL_SEC=3600

# 调用凭据允许的最大有效期，单位秒。
# 是否必须显式配置：否。
# 默认值：259200。
AGENT_CREDENTIAL_MAX_TTL_SEC=259200

# 新建调用凭据默认最大调用次数。
# 是否必须显式配置：否。
# 默认值：1000。
AGENT_CREDENTIAL_MAX_CALLS_DEFAULT=1000

# Owner 控制面每分钟限流。
# 是否必须显式配置：否。
# 默认值：240。
OWNER_RATE_LIMIT_PER_MIN=240

# Agent 数据面每分钟限流。
# 是否必须显式配置：否。
# 默认值：600。
AGENT_RATE_LIMIT_PER_MIN=600

# 整个服务聚合限流，每分钟。
# 是否必须显式配置：否。
# 默认值：1200。
SERVICE_RATE_LIMIT_PER_MIN=1200

# 限流窗口大小，单位秒。
# 是否必须显式配置：否。
# 默认值：60。
RATE_LIMIT_WINDOW_SEC=60

# 是否要求 /generate 必须带 X-Credential。
# 是否必须显式配置：否。
# 默认值：0。
REQUIRE_AGENT_CREDENTIAL_FOR_GENERATE=0

# Redis 统一连接串；用于分布式限流 / 计数。
# 是否必须显式配置：否，单机可留空。
REDIS_URL=

# Redis 用户名。
# 是否必须显式配置：否。
REDIS_USERNAME=

# Redis 密码。
# 是否必须显式配置：否。
REDIS_PASSWORD=

# Redis 主机；如果不写 REDIS_URL，可改用 host/port/db 组合。
# 是否必须显式配置：否。
REDIS_HOST=

# Redis 端口。
# 是否必须显式配置：否。
# 默认值：6379。
REDIS_PORT=6379

# Redis DB 库编号。
# 是否必须显式配置：否。
# 默认值：0。
REDIS_DB=0

# 卖家可声明的最小超时，单位毫秒。
# 是否必须显式配置：否。
# 默认值：300。
GATEWAY_MIN_TIMEOUT_MS=300

# 卖家可声明的最大超时，单位毫秒。
# 是否必须显式配置：否。
# 默认值：15000。
GATEWAY_MAX_TIMEOUT_MS=15000

# 卖家可声明的最小请求体大小限制，单位字节。
# 是否必须显式配置：否。
# 默认值：256。
GATEWAY_MIN_REQUEST_BYTES=256

# 卖家可声明的最大请求体大小限制，单位字节。
# 是否必须显式配置：否。
# 默认值：262144。
GATEWAY_MAX_REQUEST_BYTES=262144

# 卖家可声明的最小响应体大小限制，单位字节。
# 是否必须显式配置：否。
# 默认值：256。
GATEWAY_MIN_RESPONSE_BYTES=256

# 卖家可声明的最大响应体大小限制，单位字节。
# 是否必须显式配置：否。
# 默认值：1048576。
GATEWAY_MAX_RESPONSE_BYTES=1048576

# 卖家可声明的最小 QPS。
# 是否必须显式配置：否。
# 默认值：1。
GATEWAY_MIN_SERVICE_QPS=1

# 卖家可声明的最大 QPS。
# 是否必须显式配置：否。
# 默认值：200。
GATEWAY_MAX_SERVICE_QPS=200

# 服务注册默认超时，单位毫秒。
# 是否必须显式配置：否。
# 默认值：3000。
GATEWAY_DEFAULT_TIMEOUT_MS=3000

# 服务注册默认请求体上限，单位字节。
# 是否必须显式配置：否。
# 默认值：4096。
GATEWAY_DEFAULT_REQUEST_BYTES=4096

# 服务注册默认响应体上限，单位字节。
# 是否必须显式配置：否。
# 默认值：2048。
GATEWAY_DEFAULT_RESPONSE_BYTES=2048

# 服务注册默认 QPS。
# 是否必须显式配置：否。
# 默认值：50。
GATEWAY_DEFAULT_SERVICE_QPS=50

# --------------------------------------------------
# 六、平台费率与管理钱包
# --------------------------------------------------

# 平台抽成比例，取值范围 0.0 ~ 1.0。
# 是否必须显式配置：否。
# 默认值：0.10。
PLATFORM_FEE_RATE=0.10

# 每次调用固定路由税，单位 USDC。
# 是否必须显式配置：否。
# 默认值：0.0001。
GATEWAY_ROUTING_TAX=0.0001

# 可管理平台费率配置的钱包白名单，多个地址用逗号分隔。
# 是否必须显式配置：如果你要调用平台费率管理接口，则必须配置。
PLATFORM_FEE_ADMIN_WALLETS=

# 可访问索引器状态接口的钱包白名单；留空时回退到 PLATFORM_FEE_ADMIN_WALLETS。
# 是否必须显式配置：否。
INDEXER_ADMIN_WALLETS=

# gateway-admin -> gateway 内部管理 JWT 密钥。
# 是否必须显式配置：如果启用 gateway-admin 对 gateway 的内部审批/执行命令，必须与 gateway-admin 侧保持一致。
GATEWAY_INTERNAL_JWT_SECRET=

# gateway-admin -> gateway 内部管理 JWT issuer。
# 是否必须显式配置：建议显式配置；默认值为 gateway-admin。
GATEWAY_INTERNAL_TOKEN_ISSUER=gateway-admin

# gateway-admin -> gateway 内部管理 JWT audience。
# 是否必须显式配置：建议显式配置；默认值为 gateway-internal。
GATEWAY_INTERNAL_TOKEN_AUDIENCE=gateway-internal

# 允许调用 gateway 内部管理接口的服务主体，多个值用逗号分隔。
# 是否必须显式配置：建议显式配置；默认值为 service:gateway-admin。
GATEWAY_INTERNAL_SERVICE_SUBJECTS=service:gateway-admin

# --------------------------------------------------
# 七、提现风控与健康检查
# --------------------------------------------------

# Provider 提现签名单据有效期，单位秒。
# 是否必须显式配置：否。
# 默认值：900。
PROVIDER_WITHDRAW_DEADLINE_SEC=900

# 自动通过的单笔提现上限，单位 USDC。
# 是否必须显式配置：否。
# 默认值：100。
WITHDRAWAL_AUTO_SINGLE_LIMIT_USDC=100

# 24 小时自动通过累计提现上限，单位 USDC。
# 是否必须显式配置：否。
# 默认值：500。
WITHDRAWAL_AUTO_24H_LIMIT_USDC=500

# 提现风控统计窗口，单位小时。
# 是否必须显式配置：否。
# 默认值：24。
WITHDRAWAL_WINDOW_HOURS=24

# 高风险 Provider 地址名单，多个地址用逗号分隔。
# 是否必须显式配置：否。
WITHDRAWAL_HIGH_RISK_PROVIDER_ADDRESSES=

# 是否启用服务健康探测。
# 是否必须显式配置：否。
# 默认值：1。
SERVICE_HEALTH_MONITOR_ENABLED=1

# 健康探测间隔，单位秒。
# 是否必须显式配置：否。
# 默认值：15。
SERVICE_HEALTH_PROBE_INTERVAL_SEC=15

# 健康探测超时，单位毫秒。
# 是否必须显式配置：否。
# 默认值：1500。
SERVICE_HEALTH_PROBE_TIMEOUT_MS=1500

# 多久无新探测结果就认为服务状态过期，单位秒。
# 是否必须显式配置：否。
# 默认值：120。
SERVICE_HEALTH_STALE_AFTER_SEC=120

# 服务连续不可用多久后触发 outage analytics 事件，单位秒。
# 是否必须显式配置：否。
# 默认值：1800。
SERVICE_HEALTH_OUTAGE_AFTER_SEC=1800

# 服务进入 slow lane 降频探活前的连续不可用时间，单位秒。
# 是否必须显式配置：否。
# 默认值：1800。
SERVICE_HEALTH_SLOW_LANE_AFTER_SEC=1800

# active + unhealthy 服务进入 slow lane 后的探活间隔，单位秒。
# 是否必须显式配置：否。
# 默认值：300。
SERVICE_HEALTH_SLOW_LANE_INTERVAL_SEC=300

# suspended 服务的默认探活间隔，单位秒。
# 是否必须显式配置：否。
# 默认值：300。
SERVICE_HEALTH_SLOW_LANE_SUSPENDED_INTERVAL_SEC=300

# 转发时是否要求目标服务必须健康。
# 是否必须显式配置：否。
# 默认值：1。
FORWARDING_REQUIRE_HEALTHY_TARGETS=1

# 是否记录健康历史。
# 是否必须显式配置：否。
# 默认值：1。
SERVICE_HEALTH_HISTORY_ENABLED=1

# 健康历史保留时长，单位小时。
# 是否必须显式配置：否。
# 默认值：168。
SERVICE_HEALTH_HISTORY_RETENTION_HOURS=168

# 健康历史清理间隔，单位秒。
# 是否必须显式配置：否。
# 默认值：300。
SERVICE_HEALTH_HISTORY_PRUNE_INTERVAL_SEC=300

# 每个目标保留的默认历史条数。
# 是否必须显式配置：否。
# 默认值：50。
SERVICE_HEALTH_HISTORY_DEFAULT_LIMIT_PER_TARGET=50

# --------------------------------------------------
# 八、服务监听地址
# --------------------------------------------------

# 主应用监听地址。
# 是否必须显式配置：否。
# 默认值：0.0.0.1。
HOST=0.0.0.1

# 主应用监听端口。
# 是否必须显式配置：否。
# 默认值：5000。
PORT=5000

# provider_fastapi 兼容入口监听地址。
# 是否必须显式配置：建议显式配置。
# 默认值：127.0.0.1。
PROVIDER_API_HOST=127.0.0.1

# provider_fastapi 兼容入口监听端口。
# 是否必须显式配置：建议显式配置。
# 默认值：8000。
PROVIDER_API_PORT=8000

# --------------------------------------------------
# 九、可选 AI / SDK / 对象存储配置
# 说明：只有相关功能开启时才需要。
# --------------------------------------------------

# 买家 SDK 调用的网关基地址。
API_BASE_URL=http://127.0.0.1:8000/api/client

# DeepSeek API Key，仅 parse-curl 等 AI 辅助能力使用。
DEEPSEEK_API_KEY=

# DeepSeek 基础地址。
# 默认值：https://api.deepseek.com。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek 默认模型。
# 默认值：deepseek-chat。
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek 请求超时，单位秒。
# 默认值：30。
DEEPSEEK_TIMEOUT_S=30

# SDK / 负载存储模式，仅相关脚本使用。
STORAGE_MODE=MINIO

# MinIO 服务地址。
MINIO_ENDPOINT=http://127.0.0.1:9000

# MinIO Access Key。
MINIO_ACCESS_KEY=admin

# MinIO Secret Key。
MINIO_SECRET_KEY=12345678

# MinIO Bucket 名称。
MINIO_BUCKET_NAME=a2a-payloads
