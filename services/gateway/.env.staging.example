# ==================================================
# Synapse Gateway Staging Environment Example
# ==================================================
#
# Usage:
# 1. Copy this file to services/gateway/.env.staging.
# 2. Replace every replace-with-* / 0xYour* placeholder before staging.
# 3. Never commit the real .env.staging file.
# 4. Prefer Google Secret Manager or protected VM env injection on GCP.
#
# Staging chain target:
# - Network: Arbitrum Sepolia
# - chainId: 421614
# - Token: owner-only MockUSDC deployed by our staging deployment script
# - Not production USDC
#
# Keep deploy-time secrets separate from runtime secrets where possible.

# --------------------------------------------------
# 1. Runtime identity and logging
# --------------------------------------------------

# Gateway runtime environment name. Staging must be "staging".
ENVIRONMENT=staging

# Public User-front origin allowed to call Gateway from browsers.
# Keep this exact and do not include localhost in staging.
CORS_ALLOW_ORIGINS=https://staging.synapse-network.ai

# Gateway log level. INFO is the safe staging default; use DEBUG only for short investigations.
GATEWAY_LOG_LEVEL=INFO

# Directory for structured Gateway logs inside the container or VM.
GATEWAY_LOG_DIR=/var/log/synapse/gateway

# Gateway log file name under GATEWAY_LOG_DIR.
GATEWAY_LOG_FILE_NAME=gateway-runtime.log

# Daily log rotation time. "00:00" means rotate at midnight.
GATEWAY_LOG_ROTATION=00:00

# Log retention in days. Code enforces a minimum of 14.
GATEWAY_LOG_RETENTION_DAYS=14

# --------------------------------------------------
# 2. Metrics and readiness security
# --------------------------------------------------

# Bearer token required by the app-layer /metrics guard.
# Reverse proxy / firewall must still block public /metrics access before traffic reaches Gateway.
METRICS_BEARER_TOKEN=replace-with-secret-manager-synapse-staging-metrics-bearer-token

# Optional Basic Auth username for /metrics. Leave empty when using bearer token only.
METRICS_BASIC_USERNAME=

# Optional Basic Auth password for /metrics. Leave empty when using bearer token only.
METRICS_BASIC_PASSWORD=

# --------------------------------------------------
# 3. Arbitrum Sepolia runtime chain config
# --------------------------------------------------

# Runtime RPC used by Gateway deposit indexer, receipt checks, reaper/watcher chain reads.
# For Alchemy Free plan this is usually:
# https://arb-sepolia.g.alchemy.com/v2/<api-key>
RPC_URL=replace-with-secret-manager-synapse-staging-arbitrum-sepolia-rpc-url

# Same RPC URL, but read by Hardhat deployment/evidence scripts.
# Usually identical to RPC_URL. Do not commit a real API key.
ARBITRUM_SEPOLIA_RPC_URL=replace-with-secret-manager-synapse-staging-arbitrum-sepolia-rpc-url

# SynapseCore / vault / router contract address on Arbitrum Sepolia.
# Fill from docs/evidence/release/contracts/arbitrum-sepolia/<timestamp>-deploy/contract-manifest.json.
ROUTER_ADDRESS=0x0bA1dcE1Cc8d877052ab1C3CE2362830459D8FF4

# Owner-only MockUSDC contract address on Arbitrum Sepolia.
# Staging uses MockUSDC; do not put production USDC here.
USDC_TOKEN_ADDRESS=0xfad31daE42B0046aFA106BCf56ED0dDaCA4463B9

# Hard timeout for Web3 HTTP calls in seconds.
# Must stay lower than V2_INDEXER_STEP_TIMEOUT_SEC so one RPC call cannot freeze an indexer tick.
RPC_REQUEST_TIMEOUT_SEC=10

# --------------------------------------------------
# 4. Gateway withdrawal signer
# --------------------------------------------------

# Staging Gateway uses Cloud KMS for withdrawal ticket signing.
# Derive this address with scripts/chain/gcp_kms_derive_eth_address.mjs and
# rotate SynapseCore.platformSigner() to the same address before deployment.
WITHDRAW_SIGNER_MODE=gcp_kms
WITHDRAW_SIGNER_GCP_KMS_KEY_NAME=projects/<staging-project>/locations/us-central1/keyRings/synapse-staging/cryptoKeys/synapse-staging-withdraw-signer/cryptoKeyVersions/1
WITHDRAW_SIGNER_ADDRESS=0xStagingKmsDerivedEthereumSignerAddress
# Legacy only: do not inject into Gateway after KMS migration evidence is green.
# PRIVATE_KEY=replace-with-secret-manager-synapse-staging-private-key

# --------------------------------------------------
# 5. Contract deployment-only variables
# --------------------------------------------------
#
# These are needed for:
# - npm run deploy:contracts:arbitrum-sepolia:dry-run
# - npm run deploy:contracts:arbitrum-sepolia
# - npm run ci:contract-deployment-evidence
#
# Gateway runtime does not need STAGING_DEPLOYER_PRIVATE_KEY or ARBISCAN_API_KEY.
# Prefer loading these only in the deployment shell or from Secret Manager.

# Private key of the staging deployer wallet. Needs Arbitrum Sepolia ETH for gas.
STAGING_DEPLOYER_PRIVATE_KEY=replace-with-secret-manager-synapse-staging-deployer-private-key

# Final owner address for MockUSDC and SynapseCore.
# This address can rotate signer and owner-only mint staging MockUSDC.
STAGING_CONTRACT_OWNER_ADDRESS=0x1896285a84ED0aa7C654B2547b3dDF137B974cCE

# Public address of the Gateway withdrawal signer.
# Must match the staging KMS-derived signer address.
STAGING_WITHDRAW_SIGNER_ADDRESS=0xStagingKmsDerivedEthereumSignerAddress

# Etherscan API V2 key for Arbitrum Sepolia source verification.
# The legacy variable name is kept for script compatibility.
# Used by Hardhat verify only; not used by Gateway runtime.
ARBISCAN_API_KEY=replace-with-secret-manager-synapse-staging-arbiscan-api-key

# Dedicated staging E2E consumer wallet address.
# Dry-run checks it has gas; deployment pre-mints MockUSDC to it.
STAGING_TEST_CONSUMER_ADDRESS=0xCe11fdE2BAF4FAe4029954A1Dd174CdaBDBfE934

# Dedicated staging E2E provider wallet address.
# Dry-run checks it has gas; deployment pre-mints MockUSDC to it.
STAGING_TEST_PROVIDER_ADDRESS=0xaB1190Eb3AD5094BF3bD8F0CDb1e5AE21f2D6e6E

# Minimum Arbitrum Sepolia ETH required for deployer/consumer/provider preflight.
STAGING_MIN_GAS_ETH=0.01

# Optional local-only funded wallet used by the staging wallet utility to top up
# deployer/consumer/provider gas. If unset, the script falls back to
# STAGING_GAS_FUNDER_SECRET_ID in GCP Secret Manager. Do not inject either into
# Cloud Run runtime.
STAGING_GAS_FUNDER_PRIVATE_KEY=

# Optional Secret Manager id used by the wallet utility when
# STAGING_GAS_FUNDER_PRIVATE_KEY is not exported locally.
STAGING_GAS_FUNDER_SECRET_ID=synapse-staging-gas-funder-private-key

# Optional top-up target used by `npm run staging:arb-sepolia:wallets:fund`.
# The wallet utility sends only the missing delta up to this target.
STAGING_FUND_TARGET_GAS_ETH=0.02

# MockUSDC amount pre-minted to each dedicated staging E2E wallet during deployment.
STAGING_TEST_MOCK_USDC_PREMINT=100000

# Deployment transaction confirmations before evidence continues.
STAGING_DEPLOY_CONFIRMATIONS=5

# Delay before explorer verification to avoid indexing race.
STAGING_VERIFY_DELAY_MS=15000

# Max explorer verification attempts per contract.
STAGING_VERIFY_RETRIES=5

# Delay between explorer verification retries.
STAGING_VERIFY_RETRY_DELAY_MS=15000

# --------------------------------------------------
# 6. Chain indexer and reconciliation
# --------------------------------------------------

# Required confirmations before crediting a deposit intent.
# For Arbitrum Sepolia staging, keep low enough for E2E speed but not zero.
V2_DEPOSIT_CONFIRMATIONS=1

# Cloud Run staging runs the indexer as a scheduled one-shot job every minute.
# Keep false in API services to avoid background work inside request-serving instances.
V2_INDEXER_ENABLED=false

# Deposit indexer poll interval in seconds.
# This is the real Gateway variable for chain watcher pacing.
V2_INDEXER_POLL_INTERVAL_SEC=15

# Delay before first indexer tick so /health and /readiness can become responsive after boot.
V2_INDEXER_STARTUP_DELAY_SEC=3

# Upper bound for one deposit indexer tick in seconds.
V2_INDEXER_STEP_TIMEOUT_SEC=20

# Readiness marks indexer stale after this many seconds without heartbeat.
V2_INDEXER_STALE_AFTER_SEC=90

# Max confirmed blocks scanned per backfill round.
V2_BACKFILL_BLOCK_BATCH=100

# Enable missed-deposit backfill scanner.
V2_BACKFILL_ENABLED=true

# Optional fixed start block for first backfill scan. 0 means auto-bootstrap.
V2_BACKFILL_START_BLOCK=0

# Enable chain-vs-ledger reconciliation monitor.
V2_RECONCILIATION_ENABLED=true

# Minimum seconds between reconciliation checks.
V2_RECONCILIATION_INTERVAL_SEC=60

# Alert threshold in USDC for unexplained chain-vs-ledger delta.
V2_RECONCILIATION_ALERT_DELTA_USDC=0.000001

# --------------------------------------------------
# 7. One-ticket withdrawal lifecycle and reaper
# --------------------------------------------------

# Ticket TTL in seconds. 1800 = 30 minutes.
PROVIDER_WITHDRAW_DEADLINE_SEC=1800

# Local time buffer after ticket deadline before reaper may release funds.
# 900 = 15 minutes.
WITHDRAW_TICKET_EXPIRY_BUFFER_SEC=900

# RPC latest block timestamp must also exceed ticket deadline by this margin before release.
# 300 = 5 minutes.
WITHDRAW_RPC_FINALITY_MARGIN_SEC=300

# Cloud Run staging runs withdrawal processors as scheduled one-shot jobs every minute.
# Keep false in API services; each job also uses a Postgres advisory lock.
PROVIDER_WITHDRAW_EXPIRY_REAPER_ENABLED=false

# Reaper poll interval in seconds.
# This is the real Gateway variable; use this instead of REAPER_POLL_INTERVAL_SEC.
PROVIDER_WITHDRAW_EXPIRY_REAPER_INTERVAL_SEC=60

# Enable consumer withdrawal recovery processor / watcher in API process.
# Cloud Run staging keeps this false and uses the scheduled job.
CONSUMER_WITHDRAW_PROCESSOR_ENABLED=false

# Auto-approval single-withdrawal threshold in USDC.
# Amounts above this go to manual review.
WITHDRAWAL_AUTO_SINGLE_LIMIT_USDC=100.000000

# Auto-approval rolling 24h threshold in USDC.
WITHDRAWAL_AUTO_24H_LIMIT_USDC=500.000000

# Rolling window size for withdrawal risk checks.
WITHDRAWAL_WINDOW_HOURS=24

# Comma-separated provider addresses always treated as high risk.
WITHDRAWAL_HIGH_RISK_PROVIDER_ADDRESSES=

# --------------------------------------------------
# 8. Storage and database
# --------------------------------------------------

# Storage backend. Staging should use postgres.
STORAGE_BACKEND=postgres

# PostgreSQL DSN used by Gateway.
# Use a least-privilege staging DB user, not postgres superuser.
# Cloud Run staging should inject this full Cloud SQL Unix-socket DSN from
# Secret Manager to avoid reconstructing socket URLs in the app process.
POSTGRES_DSN=replace-with-secret-manager-synapse-staging-postgres-dsn

# Optional Postgres host when POSTGRES_DSN is omitted, or a diagnostic fallback
# alongside the Secret Manager POSTGRES_DSN.
POSTGRES_HOST=/cloudsql/fabled-archive-494108-k5:us-central1:synapse-staging-postgres

# Optional Postgres port when POSTGRES_DSN is omitted.
POSTGRES_PORT=5432

# Optional Postgres username when POSTGRES_DSN is omitted.
POSTGRES_USER=synapse_gateway_app

# Optional Postgres password when POSTGRES_DSN is omitted.
POSTGRES_PASSWORD=replace-with-secret-manager-synapse-staging-postgres-password

# Optional Postgres database name when POSTGRES_DSN is omitted.
POSTGRES_DB=synapse_gateway_staging

# Migrator credentials used only by the explicit DB migration job/release shell.
# Runtime API services must not receive POSTGRES_MIGRATOR_PASSWORD.
POSTGRES_MIGRATOR_USER=synapse_gateway_migrator
POSTGRES_MIGRATOR_PASSWORD=replace-with-secret-manager-synapse-staging-postgres-migrator-password

# Postgres connection timeout in seconds.
POSTGRES_CONNECT_TIMEOUT_SEC=5

# Max reusable Postgres connections kept by each Gateway process.
# Keep low on Cloud SQL db-f1-micro. Total possible connections are roughly
# Cloud Run max instances * POSTGRES_POOL_MAX.
# Valid range is 1..10. Values above 10 fail startup with DB-CONFIG-001.
# Do not append SQLAlchemy-style ?pool_size=5&max_overflow=2 to POSTGRES_DSN;
# Gateway uses psycopg_pool.ConnectionPool.
POSTGRES_POOL_MAX=5

# Seconds to wait for a pooled Postgres connection before failing fast.
POSTGRES_POOL_TIMEOUT_SEC=5

# Seconds before psycopg_pool retires an old connection.
POSTGRES_POOL_MAX_LIFETIME_SEC=1800

# Seconds before psycopg_pool closes idle connections.
POSTGRES_POOL_MAX_IDLE_SEC=300

# Whether Gateway auto-creates tables/indexes on startup.
# Staging should normally use explicit DB bootstrap/migrations, so keep 0.
POSTGRES_AUTO_INIT=0

# --------------------------------------------------
# 9. Redis and distributed rate limits
# --------------------------------------------------

# Redis is a growth-stage component. MVP Cloud Run staging uses Postgres row locks,
# unique constraints, and advisory job locks instead.
REDIS_URL=

# Optional Redis host when REDIS_URL is omitted.
REDIS_HOST=

# Optional Redis port when REDIS_URL is omitted.
REDIS_PORT=6379

# Optional Redis DB when REDIS_URL is omitted.
REDIS_DB=0

# Optional Redis username.
REDIS_USERNAME=

# Optional Redis password.
REDIS_PASSWORD=

# --------------------------------------------------
# 10. Auth, internal service auth, and provider signatures
# --------------------------------------------------

# JWT secret for owner/provider auth tokens.
# Must be at least 32 bytes, staging-specific, and not reused in prod.
JWT_SECRET=replace-with-secret-manager-synapse-staging-jwt-secret

# Wallet challenge/auth secret. Can be separate from JWT_SECRET.
AUTH_SECRET=replace-with-secret-manager-synapse-staging-auth-secret

# Separate secret for gateway-admin -> gateway internal command tokens.
GATEWAY_INTERNAL_JWT_SECRET=replace-with-secret-manager-synapse-staging-gateway-internal-jwt-secret

# HMAC/provider signature secret used by provider-bound flows.
GATEWAY_PROVIDER_SIGNATURE_SECRET=replace-with-staging-provider-signature-secret

# Expected issuer for internal service JWTs.
GATEWAY_INTERNAL_TOKEN_ISSUER=gateway-admin

# Expected audience for internal service JWTs.
GATEWAY_INTERNAL_TOKEN_AUDIENCE=gateway-internal

# Comma-separated internal service subjects allowed to call internal admin APIs.
GATEWAY_INTERNAL_SERVICE_SUBJECTS=service:gateway-admin

# Auth token TTL in seconds.
AUTH_TOKEN_TTL_SEC=86400

# Wallet challenge TTL in seconds.
AUTH_CHALLENGE_TTL_SEC=600

# --------------------------------------------------
# 11. Finance idempotency, replay, and mutation limits
# --------------------------------------------------

# Financial idempotency record TTL in seconds.
FINANCE_IDEMPOTENCY_TTL_SEC=86400

# Max cached idempotency rows retained after pruning.
FINANCE_IDEMPOTENCY_MAX_ROWS=10000

# Replay-protection window for duplicate tx/retry collisions.
FINANCE_REPLAY_WINDOW_SEC=900

# Owner-scoped finance write rate limit per minute.
FINANCE_WRITE_RATE_LIMIT_PER_MIN=60

# --------------------------------------------------
# 12. Billing and admin wallet allowlists
# --------------------------------------------------

# Global platform fee rate. 0.10 = 10%.
PLATFORM_FEE_RATE=0.10

# Fixed gateway routing tax in USDC per request.
GATEWAY_ROUTING_TAX=0.0001

# Wallets allowed to manage platform fee policy.
PLATFORM_FEE_ADMIN_WALLETS=0xYourArbitrumSepoliaAdminWallet

# Wallets allowed to access indexer status controls.
# If empty, Gateway falls back to PLATFORM_FEE_ADMIN_WALLETS.
INDEXER_ADMIN_WALLETS=0xYourArbitrumSepoliaAdminWallet

# --------------------------------------------------
# 13. Runtime forwarding limits and credential limits
# --------------------------------------------------

# Default credential TTL in seconds.
AGENT_CREDENTIAL_DEFAULT_TTL_SEC=3600

# Maximum credential TTL in seconds.
AGENT_CREDENTIAL_MAX_TTL_SEC=259200

# Default max calls per newly issued credential.
AGENT_CREDENTIAL_MAX_CALLS_DEFAULT=1000

# Owner control-plane rate limit per minute.
OWNER_RATE_LIMIT_PER_MIN=240

# Credential data-plane rate limit per minute.
AGENT_RATE_LIMIT_PER_MIN=600

# Service aggregate rate limit per minute.
SERVICE_RATE_LIMIT_PER_MIN=1200

# Rate-limit sliding window in seconds.
RATE_LIMIT_WINDOW_SEC=60

# Whether /generate requires X-Credential.
REQUIRE_AGENT_CREDENTIAL_FOR_GENERATE=false

# Minimum upstream timeout in provider manifests.
GATEWAY_MIN_TIMEOUT_MS=300

# Maximum upstream timeout for ordinary API provider manifests.
GATEWAY_MAX_TIMEOUT_MS=60000

# Minimum request bytes allowed in provider manifests.
GATEWAY_MIN_REQUEST_BYTES=256

# Maximum request bytes allowed in provider manifests.
GATEWAY_MAX_REQUEST_BYTES=262144

# Minimum response bytes allowed in provider manifests.
GATEWAY_MIN_RESPONSE_BYTES=256

# Maximum response bytes allowed in provider manifests.
GATEWAY_MAX_RESPONSE_BYTES=1048576

# Minimum service QPS allowed in provider manifests.
GATEWAY_MIN_SERVICE_QPS=1

# Maximum service QPS allowed in provider manifests.
GATEWAY_MAX_SERVICE_QPS=200

# Default upstream timeout for ordinary API provider manifests.
GATEWAY_DEFAULT_TIMEOUT_MS=15000

# Default bounded synchronous timeout for LLM token-metered provider manifests.
GATEWAY_LLM_DEFAULT_TIMEOUT_MS=120000

# Maximum bounded synchronous timeout for LLM token-metered provider manifests.
GATEWAY_LLM_MAX_TIMEOUT_MS=300000

# Default request bytes when provider manifest omits it.
GATEWAY_DEFAULT_REQUEST_BYTES=4096

# Default response bytes when provider manifest omits it.
GATEWAY_DEFAULT_RESPONSE_BYTES=2048

# Default service QPS when provider manifest omits it.
GATEWAY_DEFAULT_SERVICE_QPS=50

# --------------------------------------------------
# 14. Provider health monitor
# --------------------------------------------------

# Enable background provider health checks.
SERVICE_HEALTH_MONITOR_ENABLED=true

# Provider health probe interval in seconds.
SERVICE_HEALTH_PROBE_INTERVAL_SEC=60

# Upper bound for one provider health monitor tick.
SERVICE_HEALTH_MONITOR_STEP_TIMEOUT_SEC=20

# Per-provider probe timeout in milliseconds.
SERVICE_HEALTH_PROBE_TIMEOUT_MS=1500

# Max concurrent provider health probes.
SERVICE_HEALTH_MAX_CONCURRENCY=50

# Smooth startup rehydrate window in seconds.
SERVICE_HEALTH_REHYDRATE_WINDOW_SEC=120

# Enable jitter so many providers do not probe at the same instant.
SERVICE_HEALTH_JITTER_ENABLED=true

# Startup jitter window in seconds.
SERVICE_HEALTH_STARTUP_JITTER_SEC=10

# Jitter strategy. "stable" keeps provider-specific spread predictable.
SERVICE_HEALTH_JITTER_STRATEGY=stable

# Mark provider health stale after this many seconds without a fresh probe.
SERVICE_HEALTH_STALE_AFTER_SEC=90

# Treat provider as long-outage after this many seconds.
SERVICE_HEALTH_OUTAGE_AFTER_SEC=1800

# Move long-outage providers into slow lane after this many seconds.
SERVICE_HEALTH_SLOW_LANE_AFTER_SEC=1800

# Keep provider health history for this many hours.
SERVICE_HEALTH_HISTORY_RETENTION_HOURS=168

# --------------------------------------------------
# 15. Optional DeepSeek manifest parser
# --------------------------------------------------

# DeepSeek API key used by parse-curl service-manifest helper.
# Leave empty if disabled in staging.
DEEPSEEK_API_KEY=

# DeepSeek API base URL.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek model name.
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek request timeout in seconds.
DEEPSEEK_TIMEOUT_S=30

# --------------------------------------------------
# 16. Gateway listener
# --------------------------------------------------

# provider_fastapi compatibility host.
PROVIDER_API_HOST=0.0.0.0

# provider_fastapi compatibility port.
PROVIDER_API_PORT=8000

# --------------------------------------------------
# 17. Gmail async notification outbox
# --------------------------------------------------

# Enable durable Gmail outbox writes. Request handlers enqueue only; the
# notification-outbox Cloud Run Job performs SMTP delivery.
EMAIL_OUTBOX_ENABLED=true

# Email transport mode. V1 uses Gmail SMTP / Google Workspace SMTP relay.
EMAIL_TRANSPORT=gmail_smtp

# Gmail SMTP host.
GMAIL_SMTP_HOST=smtp.gmail.com

# Gmail SMTP port for STARTTLS.
GMAIL_SMTP_PORT=587

# Dedicated staging sender account.
GMAIL_SMTP_USERNAME=staging-alerts@synapse-network.ai

# Gmail app password or SMTP relay credential.
GMAIL_SMTP_APP_PASSWORD=replace-with-secret-manager-synapse-staging-gmail-app-password

# From header shown to users/admins.
EMAIL_FROM="Synapse Network Staging <staging-alerts@synapse-network.ai>"

# Reply-To header.
EMAIL_REPLY_TO=support@synapse-network.ai

# Public Gateway base URL used in signed email verification links.
PUBLIC_GATEWAY_BASE_URL=https://api-staging.synapse-network.ai
PUBLIC_APP_BASE_URL=https://staging.synapse-network.ai

# SMTP send timeout in seconds.
EMAIL_SEND_TIMEOUT_SEC=10

# Max outbox rows processed per worker batch.
EMAIL_WORKER_BATCH_SIZE=20

# Max attempts before an email outbox item is marked failed.
EMAIL_OUTBOX_MAX_ATTEMPTS=8

# Base retry delay in seconds for email outbox retries.
EMAIL_OUTBOX_RETRY_BASE_SEC=30

# Per-minute sending cap for staging Gmail sender.
EMAIL_MAX_PER_MINUTE=30

# Soft daily Gmail quota alert threshold.
EMAIL_GMAIL_DAILY_SOFT_LIMIT=300

# Hard daily Gmail quota cutoff.
EMAIL_GMAIL_DAILY_HARD_LIMIT=450

# Staging transaction watch cards. Success receipts are noisy in prod, so prod
# should default this false and alert only on high-value/failure/manual-review events.
TRANSACTION_LARK_ENABLED=true
TRANSACTION_LARK_WEBHOOK_URL=replace-with-secret-manager-synapse-staging-lark-webhook-staging-drill
TRANSACTION_LARK_SECRET=replace-with-secret-manager-synapse-staging-lark-secret-staging-drill
TRANSACTION_LARK_TIMEOUT_SEC=8

# --------------------------------------------------
# 18. Postgres in-app notification inbox
# --------------------------------------------------

# Cloud Run staging runs this as a daily scheduled one-shot job, not inside API.
IN_APP_NOTIFICATION_CLEANUP_ENABLED=false

# Cleanup interval in seconds. 86400 = daily cleanup.
IN_APP_NOTIFICATION_CLEANUP_INTERVAL_SEC=86400

# Standard inbox retention in days.
IN_APP_NOTIFICATION_RETENTION_DAYS=90

# Security notification retention in days. Long-term audit still lives in audit log / ledger / chain evidence.
IN_APP_NOTIFICATION_SECURITY_RETENTION_DAYS=180

# Max rows deleted per cleanup batch to avoid locking the hot inbox table.
IN_APP_NOTIFICATION_CLEANUP_BATCH_SIZE=1000

# --------------------------------------------------
# 19. Release E2E helper variables
# --------------------------------------------------
#
# These are not read by normal Gateway runtime. They are useful when running:
# npm run release:evidence:gateway-fullchain:staging

# Gateway release E2E RPC. Usually point it at ARBITRUM_SEPOLIA_RPC_URL.
GATEWAY_E2E_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Staging Gateway base URL for full-chain release evidence.
GATEWAY_E2E_GATEWAY_BASE=https://api-staging.synapse-network.ai

# Staging provider base URL for full-chain release evidence.
GATEWAY_E2E_PROVIDER_BASE=https://provider-staging.example.com

# Contract config JSON used by release E2E.
GATEWAY_E2E_CONTRACT_CONFIG_PATH=services/user-front/src/contract-config.arbitrum-sepolia.example.json

# E2E deployer key for staging evidence only. Prefer Secret Manager; do not commit real value.
GATEWAY_E2E_DEPLOYER_KEY=0xYourStagingE2EDeployerPrivateKey

# E2E owner wallet key for staging evidence only. Prefer Secret Manager; do not commit real value.
GATEWAY_E2E_OWNER_KEY=0xYourStagingE2EOwnerPrivateKey

# E2E provider wallet key for staging evidence only. Prefer Secret Manager; do not commit real value.
GATEWAY_E2E_PROVIDER_KEY=0xYourStagingE2EProviderPrivateKey

# ClickHouse is not required for MVP Cloud Run staging. Leave empty unless
# deliberately running the growth-stage analytics stack.
ANALYTICS_CLICKHOUSE_URL=

# Kafka is not required for MVP Cloud Run staging. Analytics uses Postgres outbox.
ANALYTICS_KAFKA_BOOTSTRAP_SERVERS=

# Kafka topic for analytics events.
ANALYTICS_KAFKA_TOPIC=synapse.analytics.events
