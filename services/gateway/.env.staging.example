# ==================================================
# Synapse Gateway 预发 / 演示环境示例
# 用途：复制为 .env.staging 后替换所有占位值。
# ==================================================

# --------------------------------------------------
# 必须自己配置，不能直接拿示例上线
# --------------------------------------------------

# 运行环境标识，预发固定为 staging。
ENVIRONMENT=staging

# 内部 Prometheus 抓取令牌；Ingress / LB 必须同时限制公网访问 /metrics。
METRICS_BEARER_TOKEN=replace-with-staging-metrics-token
METRICS_BASIC_USERNAME=
METRICS_BASIC_PASSWORD=

# 使用方式：
# 1) 复制本文件为 gateway/.env.staging
# 2) 至少替换 PRIVATE_KEY / RPC_URL / ROUTER_ADDRESS / POSTGRES_DSN / JWT_SECRET / AUTH_SECRET
# 3) 预发建议对接测试网与独立数据库，不要复用本地链或生产密钥

# 测试网 RPC。
# 当前推荐先锁定 Arbitrum Sepolia。
RPC_URL=https://arb-sepolia.g.alchemy.com/v2/your-api-key

# Gateway withdraw signer 私钥。
# 要求：必须是 0x 开头 32-byte EVM 私钥；不要复用个人浏览器钱包或生产私钥。
PRIVATE_KEY=0xYourStagingWithdrawSignerPrivateKey

# 测试网 SynapseCore / vault / router 合约地址。
ROUTER_ADDRESS=0xYourArbitrumSepoliaSynapseCoreAddress

# 测试网 USDC / MockUSDC 地址。
USDC_TOKEN_ADDRESS=0xYourArbitrumSepoliaUsdcAddress

# 存储后端。
STORAGE_BACKEND=postgres

# 预发 PostgreSQL 连接串。
POSTGRES_DSN=postgresql://synapse_gateway_app:change_me@postgres:5432/synapse_gateway_staging

# 预发环境建议默认不自动建表，统一通过显式初始化链路。
POSTGRES_AUTO_INIT=0

# provider_fastapi 兼容入口监听地址。
PROVIDER_API_HOST=0.0.0.0

# provider_fastapi 兼容入口监听端口。
PROVIDER_API_PORT=8000

# JWT 鉴权密钥。
JWT_SECRET=replace-with-staging-secret-32-bytes-min

# Challenge / auth 密钥。
AUTH_SECRET=replace-with-staging-secret-32-bytes-min

# --------------------------------------------------
# 可按需显式覆盖，留空时走默认值
# --------------------------------------------------

# Redis 连接；如果 staging 需要共享限流/计数，建议配置。
REDIS_URL=

# 平台费率管理钱包白名单。
# PLATFORM_FEE_ADMIN_WALLETS=0xYourArbitrumSepoliaAdminWallet

# Indexer 状态管理钱包白名单；不填会回退到 PLATFORM_FEE_ADMIN_WALLETS。
# INDEXER_ADMIN_WALLETS=0xYourArbitrumSepoliaAdminWallet
