# ==================================================
# Synapse Gateway 本地环境示例
# 用途：复制为 .env.local 后按注释逐项替换。
# ==================================================

# --------------------------------------------------
# 必须自己配置 / 至少必须核对的项
# --------------------------------------------------

# 运行环境标识，本地固定为 local。
ENVIRONMENT=local

# 使用方式：
# 1) 复制本文件为 gateway/.env.local
# 2) 至少替换 PRIVATE_KEY / RPC_URL / ROUTER_ADDRESS / POSTGRES_DSN / JWT_SECRET
# 3) 执行 sh scripts/local/restart_gateway.sh 重启网关

# 本地区块链 RPC。
# 必须自己配置：是。
RPC_URL=http://127.0.0.1:8545

# Gateway withdraw signer 私钥。
# 必须自己配置：是。
# 作用：网关使用它签发 EIP-712 withdrawal ticket；未配置时，Provider Settlements 的 Generate & Claim 会被禁用。
# 来源：本地开发请使用 Anvil / Hardhat 启动时打印出的测试账户私钥，或自行新建一个本地测试账户。
# 格式：必须是 0x 开头的 32-byte EVM 私钥，不能填助记词。
# 注意：必须与 deploy_anvil.js 中 backendSigner (signers[1]) 对应——即 Hardhat Account #1。
PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# 本地 SynapseCore / vault / router 合约地址。
# 必须自己配置：建议是；如果 frontend contract-config.json 正确，也可省略。
ROUTER_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# 本地 USDC 合约地址。
# 必须自己配置：建议是；如果 frontend contract-config.json 正确，也可省略。
USDC_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# 存储后端。当前只支持 postgres。
STORAGE_BACKEND=postgres

# 本地 PostgreSQL 连接串。
# 必须自己配置：是。
POSTGRES_DSN=postgresql://synapse_gateway_app:12345678@127.0.0.1:5432/synapse_gateway

# 是否启动时自动建表。本地首次启动可设为 1；如果库已建好，可改成 0。
# 可留默认：是。
POSTGRES_AUTO_INIT=0

# provider_fastapi 兼容入口监听地址。
# 可留默认：是。
PROVIDER_API_HOST=127.0.0.1

# provider_fastapi 兼容入口监听端口。
# 可留默认：是。
PROVIDER_API_PORT=8000

# JWT 鉴权密钥。
# 必须自己配置：是。
JWT_SECRET=local-dev-jwt-secret-32-bytes-ok-for-test

# Challenge / auth 密钥；不写会回退到 JWT_SECRET，但建议显式写上。
# 必须自己配置：建议是。
AUTH_SECRET=local-dev-auth-secret-32bytes-ok-test

# --------------------------------------------------
# 可按需显式覆盖，留空时走默认值
# --------------------------------------------------

# 平台手续费比例；默认 0.10。
# PLATFORM_FEE_RATE=0.10

# 路由税；默认 0.0001 USDC。
# GATEWAY_ROUTING_TAX=0.0001

# Redis 连接串；单机调试可不填。
# REDIS_URL=redis://localhost:6379/0

# gateway-admin -> gateway 内部管理接口本地配置。
# 必须与 services/gateway-admin/.env.local 保持一致，否则 Provider Services / 执行队列会返回 INTERNAL_TOKEN_INVALID。
PLATFORM_FEE_ADMIN_WALLETS=0xA0f67a47D9eF18183Cd113eD85A654E2772c5901
GATEWAY_INTERNAL_JWT_SECRET=pfazKmMdEZ8RCTB-8A_hH9AAknSXoP6y
GATEWAY_INTERNAL_TOKEN_ISSUER=gateway-admin
GATEWAY_INTERNAL_TOKEN_AUDIENCE=gateway-internal
GATEWAY_INTERNAL_SERVICE_SUBJECTS=service:gateway-admin

# 充值确认数；默认 1。
# V2_DEPOSIT_CONFIRMATIONS=1

# 对账告警阈值；默认 1.0 USDC。
# V2_RECONCILIATION_ALERT_DELTA_USDC=1.0

# --------------------------------------------------
# 本地交易通知 / Gmail outbox / Lark watch
# --------------------------------------------------

# 本地开启 outbox 写入；默认 E2E 会用 fake sender drain，不需要真实 Gmail 账号。
# 真实 Gmail/Lark E2E 请把私密值放在 services/gateway/.env.local.private
# 或通过 shell export 注入，避免把 app password / webhook secret 提交进 Git。
EMAIL_OUTBOX_ENABLED=true
EMAIL_TRANSPORT=gmail_smtp
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

GMAIL_SMTP_USERNAME=niubidecc
GMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM="Synapse Network Local <local@synapse.test>"
EMAIL_REPLY_TO=support@synapse-network.ai
PUBLIC_GATEWAY_BASE_URL=http://127.0.0.1:8000
PUBLIC_APP_BASE_URL=http://127.0.0.1:3000
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_OUTBOX_MAX_ATTEMPTS=8
EMAIL_OUTBOX_RETRY_BASE_SEC=30
EMAIL_GMAIL_DAILY_SOFT_LIMIT=300
EMAIL_GMAIL_DAILY_HARD_LIMIT=450

# 默认关闭本地真实 Lark 发送，避免普通本地启动刷群。
# npm run e2e:transaction-notifications:local 会自动覆盖为动态 fake Lark URL。
TRANSACTION_LARK_ENABLED=false
TRANSACTION_LARK_WEBHOOK_URL=
TRANSACTION_LARK_SECRET=
TRANSACTION_LARK_TIMEOUT_SEC=3
