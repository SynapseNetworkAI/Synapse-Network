# Synapse local E2E environment overrides.
# Copy to services/gateway/.env.e2e.local when a local E2E needs values that
# should not come from your shell or from Google Secret Manager.

SYNAPSE_E2E_ENV=local
ALLOW_GCP_SECRET_MANAGER=0

LOCAL_POSTGRES_DSN=postgresql://synapse_gateway_app:local-dev-gateway-app-password@127.0.0.1:5432/synapse_gateway
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_GATEWAY_BASE_URL=http://127.0.0.1:8000
LOCAL_ADMIN_API_URL=http://127.0.0.1:8300
LOCAL_USER_FRONT_URL=http://127.0.0.1:3000
LOCAL_ADMIN_FRONT_URL=http://127.0.0.1:4000

# Optional real local delivery values belong in services/gateway/.env.local.private,
# not here. This example intentionally has no Gmail app password, Lark webhook,
# wallet private key, or staging secret id.
