# ==================================================
# Synapse Gateway 生产环境示例
# 用途：复制为 .env.prod 后替换所有占位值。
# ==================================================

# --------------------------------------------------
# 必须自己配置，不能直接拿示例上线
# --------------------------------------------------

# 运行环境标识，生产固定为 prod。
ENVIRONMENT=prod

# 内部 Prometheus 抓取令牌；Ingress / LB 必须同时限制公网访问 /metrics。
METRICS_BEARER_TOKEN=replace-with-production-metrics-token
METRICS_BASIC_USERNAME=
METRICS_BASIC_PASSWORD=

# 使用方式：
# 1) 复制本文件为 gateway/.env.prod
# 2) 至少替换 PRIVATE_KEY / RPC_URL / ROUTER_ADDRESS / POSTGRES_DSN / JWT_SECRET / AUTH_SECRET
# 3) 生产建议通过 Secret Manager / CI 环境变量注入，禁止把真实私钥提交到仓库

# 生产链 RPC。
# 必须自己配置：是。
# 当前推荐先锁定 Arbitrum Sepolia。
RPC_URL=https://arb-sepolia.g.alchemy.com/v2/your-api-key

# Gateway withdraw signer 私钥。
# 必须自己配置：是。
# 作用：网关使用它签发 provider withdrawal ticket；未配置时，生产环境无法为 Provider 发起收益提现。
# 要求：必须是独立生产签名账户的 0x 开头 32-byte EVM 私钥，严禁复用个人浏览器钱包或测试链私钥。
PRIVATE_KEY=0xYourProductionWithdrawSignerPrivateKey

# 生产 SynapseCore / vault / router 合约地址。
# 必须自己配置：是。
# 当前推荐填 Arbitrum Sepolia 上的 SynapseCore 地址。
ROUTER_ADDRESS=0xYourArbitrumSepoliaSynapseCoreAddress

# 生产 USDC 合约地址。
# 必须自己配置：是。
USDC_TOKEN_ADDRESS=0xYourArbitrumSepoliaUsdcAddress

# 存储后端，当前只支持 postgres。
STORAGE_BACKEND=postgres

# 生产 PostgreSQL 连接串。
# 必须自己配置：是。
POSTGRES_DSN=postgresql://synapse_gateway_app:change_me@postgres:5432/synapse_gateway

# 生产建议迁移完成后设为 0，避免应用启动时隐式建表。
POSTGRES_AUTO_INIT=0

# provider_fastapi 兼容入口监听地址。
# 可留默认：是。
PROVIDER_API_HOST=0.0.0.0

# provider_fastapi 兼容入口监听端口。
# 可留默认：是。
PROVIDER_API_PORT=8000

# JWT 鉴权密钥。
# 必须自己配置：是。
JWT_SECRET=replace-with-production-secret-32-bytes-min

# Challenge / auth 密钥；建议和 JWT_SECRET 分开配置。
# 必须自己配置：建议是。
AUTH_SECRET=replace-with-production-secret-32-bytes-min

# --------------------------------------------------
# 可按需显式覆盖，留空时走默认值
# --------------------------------------------------

# Redis 连接；不需要分布式限流可不填。
REDIS_URL=

# 平台手续费比例；默认 0.10。
# PLATFORM_FEE_RATE=0.10

# 路由税；默认 0.0001 USDC。
# GATEWAY_ROUTING_TAX=0.0001

# 平台费率管理钱包白名单。
# PLATFORM_FEE_ADMIN_WALLETS=0xYourArbitrumSepoliaAdminWallet

# Indexer 状态管理钱包白名单；如果不填会回退到 PLATFORM_FEE_ADMIN_WALLETS。
# INDEXER_ADMIN_WALLETS=0xYourArbitrumSepoliaAdminWallet

# Gmail 异步邮件通知。只由 notification-outbox worker 使用；禁止在 Gateway 请求路径直接连接 SMTP。
EMAIL_TRANSPORT=gmail_smtp
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=alerts@synapse.example
GMAIL_SMTP_APP_PASSWORD=replace-with-google-app-password
EMAIL_FROM="Synapse Network <alerts@synapse.example>"
EMAIL_REPLY_TO=support@synapse.example
EMAIL_SEND_TIMEOUT_SEC=10
EMAIL_WORKER_BATCH_SIZE=50
EMAIL_OUTBOX_MAX_ATTEMPTS=8
EMAIL_OUTBOX_RETRY_BASE_SEC=30

# Gmail/Workspace 有每日发送硬限制；接近软限制必须告警，超过硬限制延后低优先级邮件。
EMAIL_MAX_PER_MINUTE=60
EMAIL_GMAIL_DAILY_SOFT_LIMIT=1500
EMAIL_GMAIL_DAILY_HARD_LIMIT=1900
