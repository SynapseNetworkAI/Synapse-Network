# ==================================================
# Synapse Gateway 本地环境示例
# 用途：复制为 .env.local 后按注释逐项替换。
# ==================================================

# --------------------------------------------------
# 必须自己配置 / 至少必须核对的项
# --------------------------------------------------

# 运行环境标识，本地固定为 local。
ENVIRONMENT=local

# 内部 Prometheus 抓取令牌；本地可留空，留空时 /metrics 返回 metrics_not_configured。
METRICS_BEARER_TOKEN=
METRICS_BASIC_USERNAME=
METRICS_BASIC_PASSWORD=

# 使用方式：
# 1) 复制本文件为 gateway/.env.local
# 2) 至少替换 PRIVATE_KEY / RPC_URL / ROUTER_ADDRESS / POSTGRES_DSN / JWT_SECRET
# 3) 执行 sh scripts/local/restart_gateway.sh 重启网关

# 本地区块链 RPC。
# 必须自己配置：是。
RPC_URL=http://127.0.0.1:8545

# Gateway withdraw signer 私钥。
# 必须自己配置：是。
# 作用：网关使用它签发 EIP-712 withdrawal ticket；未配置时，Provider Settlements 的 Generate & Claim 会被禁用。
# 来源：本地开发请使用 Anvil / Hardhat 启动时打印出的测试账户私钥，或自行新建一个本地测试账户。
# 格式：必须是 0x 开头的 32-byte EVM 私钥，不能填助记词。
PRIVATE_KEY=0xYourLocalWithdrawSignerPrivateKey

# 本地 SynapseCore / vault / router 合约地址。
# 必须自己配置：建议是；如果 frontend contract-config.json 正确，也可省略。
ROUTER_ADDRESS=0xYourLocalSynapseCoreAddress

# 本地 USDC 合约地址。
# 必须自己配置：建议是；如果 frontend contract-config.json 正确，也可省略。
USDC_TOKEN_ADDRESS=0xYourLocalUsdcAddress

# 存储后端。当前只支持 postgres。
STORAGE_BACKEND=postgres

# 本地 PostgreSQL 连接串。
# 必须自己配置：是。
POSTGRES_DSN=postgresql://synapse_gateway_app:12345678@127.0.0.1:5432/synapse_gateway

# 是否启动时自动建表。本地首次启动可设为 1；如果库已建好，可改成 0。
# 可留默认：是。
POSTGRES_AUTO_INIT=0

# provider_fastapi 兼容入口监听地址。
# 可留默认：是。
PROVIDER_API_HOST=127.0.0.1

# provider_fastapi 兼容入口监听端口。
# 可留默认：是。
PROVIDER_API_PORT=8000

# JWT 鉴权密钥。
# 必须自己配置：是。
JWT_SECRET=replace-this-with-a-32-byte-minimum-jwt-secret

# Challenge / auth 密钥；不写会回退到 JWT_SECRET，但建议显式写上。
# 必须自己配置：建议是。
AUTH_SECRET=replace-this-with-a-32-byte-minimum-jwt-secret

# --------------------------------------------------
# 可按需显式覆盖，留空时走默认值
# --------------------------------------------------

# 平台手续费比例；默认 0.10。
# PLATFORM_FEE_RATE=0.10

# 路由税；默认 0.0001 USDC。
# GATEWAY_ROUTING_TAX=0.0001

# Redis 连接串；单机调试可不填。
# REDIS_URL=redis://localhost:6379/0

# 充值确认数；默认 1。
# V2_DEPOSIT_CONFIRMATIONS=1

# 充值索引器启动延迟、单轮 timeout 和 readiness heartbeat 窗口。
# 默认分别为 3 秒、20 秒、60 秒。
# V2_INDEXER_STARTUP_DELAY_SEC=3
# V2_INDEXER_STEP_TIMEOUT_SEC=20
# V2_INDEXER_STALE_AFTER_SEC=60

# Web3 HTTP RPC 请求硬超时；必须小于或等于 V2_INDEXER_STEP_TIMEOUT_SEC。
# RPC_REQUEST_TIMEOUT_SEC=15

# 服务健康探测 monitor 单轮执行上限；默认 20 秒。
# SERVICE_HEALTH_MONITOR_STEP_TIMEOUT_SEC=20

# PostgreSQL 连接建立超时，防止后台 worker 长时间挂住连接尝试。
# POSTGRES_CONNECT_TIMEOUT_SEC=5

# 对账告警阈值；默认 1.0 USDC。
# V2_RECONCILIATION_ALERT_DELTA_USDC=1.0

# Gmail 异步邮件通知。本地默认 E2E 使用 fake sender drain，不需要真实 Gmail。
# 如果要跑 npm run e2e:transaction-notifications:local-real，请把真实值放在
# services/gateway/.env.local.private 或 shell export 中，不要写入 Git。
EMAIL_OUTBOX_ENABLED=true
EMAIL_TRANSPORT=gmail_smtp
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM="Synapse Network Local <local@synapse.test>"
EMAIL_REPLY_TO=support@synapse-network.ai
PUBLIC_GATEWAY_BASE_URL=http://127.0.0.1:8000
PUBLIC_APP_BASE_URL=http://127.0.0.1:3000
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_OUTBOX_MAX_ATTEMPTS=8
EMAIL_OUTBOX_RETRY_BASE_SEC=30
EMAIL_GMAIL_DAILY_SOFT_LIMIT=300
EMAIL_GMAIL_DAILY_HARD_LIMIT=450

# 本地默认不发真实 Lark；transaction notification local E2E 会覆盖为 fake Lark sink。
TRANSACTION_LARK_ENABLED=false
TRANSACTION_LARK_WEBHOOK_URL=
TRANSACTION_LARK_SECRET=
TRANSACTION_LARK_TIMEOUT_SEC=3

# 真实本地交易通知 E2E：
# TRANSACTION_NOTIFICATIONS_TEST_EMAIL=you@example.com
# TRANSACTION_NOTIFICATIONS_LOCAL_REAL_CONFIRM=I_UNDERSTAND_THIS_SENDS_REAL_LOCAL_EMAIL_AND_LARK
