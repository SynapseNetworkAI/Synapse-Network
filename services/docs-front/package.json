{
  "name": "docs-front",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "pregenerate:openapi": "mkdir -p public src/data",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "predev": "yarn generate:openapi",
    "build": "next build",
    "prebuild": "yarn generate:openapi",
    "dev": "next dev -p 3100",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint"
  },
  "dependencies": {
    "fumadocs-core": "16.8.5",
    "fumadocs-mdx": "14.3.2",
    "fumadocs-openapi": "10.8.1",
    "fumadocs-ui": "16.8.5",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.4",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.2"
  }
}
